entLockEpoch,\n673:     updatedAt: Date.now()\n674:   };\n675: }\n676: \n677: $('save-btn').onclick = () => {\n678:   const payload = buildQuizPayload();\n679:   if (!payload.title) {\n680:     $('status-msg').textConte\n<truncated 2950 bytes>\n:   fetchRemote.then(html => html || fetchLocal()).then(html => {\n752:     if (html) {\n753:       cachedTemplateHtml = html;\n754:       finalizeDownload(html);\n755:     } else {\n756:       $('status-msg').textContent = 'Could not load quiz template.';\n757:       $('status-msg').style.color = 'var(--bad)';\n758:     }\n759:   }).catch(() => {\n760:     $('status-msg').textContent = 'Could not load quiz template.';\n761:     $('status-msg').style.color = 'var(--bad)';\n762:   });\n763: };\n764: \n765: function escapeSubHtml(s) {\n766:   return String(s || '').replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\n767: }\n768: \n769: async function refreshSubmissions() {\n770:   if (!settingsState.autoRecordQuiz) {\n771:     syncSubViewState();\n772:     return;\n773:   }\n774:   if (subAbort) subAbort.abort();\n775:   subAbort = typeof AbortController !== 'undefined' ? new AbortController() : null;\n776:   const sig = subAbort ? subAbort.signal : undefined;\n777:   try {\n778:     const docs = await EncryptedLocalDB.listRecords(quizId, sig);\n779:     if (!settingsState.autoRecordQuiz) {\n780:       syncSubViewState();\n781:       return;\n782:     }\n783:     docs.sort((a, b) => (Number(b.submittedAt) || Number(b.ts) || 0) - (Number(a.submittedAt) || Number(a.ts) || 0));\n784:     $('sub-count-badge').textContent = docs.length + ' Done';\n785:     const feed = $('sub-feed');\n786:     if (!docs.length) {\n787:       feed.innerHTML = '<p style=\"text-align:center;padding:24px;color:var(--mu);margin:0\">No records saved yet.</p>';\n788:       return;\n789:     }\n790:     let html = '';\n791:     docs.forEach(d => {\n792:       const name = d.studentName || d.n || 'Anonymous';\n793:       const course = d.courseSection || d.s || '';\n794:       const score = d.scoreText || ((d.sc != null ? d.sc : (d.finalScore != null ? d.finalScore : 0)) + ' / ' + (d.tot || d.totalQuestions || 20));\n795:       const viol = d.violationsText || ((d.sw != null ? d.sw : (d.violations || 0)) + ' (-' + (d.pen || 0) + ' pts)');","truncated_fields":["content"]}
