olation ? '#fff' : 'var(--tx)';\n425:   $('pen-box').style.display = settingsState.enableTabViolation ? 'block' : 'none';\n426:   $('pen-val').value = settingsState.tabViolationPenalty != null ? settingsStat\n<truncated 1374 bytes>\n;\n461: $('clear-sub-btn').onclick = () => {\n462:   if (!settingsState.autoRecordQuiz) return;\n463:   pendingAction = 'clearSub';\n464:   $('confirm-modal').classList.remove('hide');\n465: };\n466: $('reset-lock-btn').onclick = () => {\n467:   pendingAction = 'resetLock';\n468:   $('confirm-modal').classList.remove('hide');\n469: };\n470: $('modal-no-btn').onclick = () => {\n471:   pendingAction = '';\n472:   $('confirm-modal').classList.add('hide');\n473: };\n474: $('modal-yes-btn').onclick = async () => {\n475:   const action = pendingAction;\n476:   pendingAction = '';\n477:   $('confirm-modal').classList.add('hide');\n478:   if (action === 'clearSub') {\n479:     if (!settingsState.autoRecordQuiz) return;\n480:     try {\n481:       await EncryptedLocalDB.purgeRecords(quizId);\n482:       await refreshSubmissions();\n483:     } catch (err) {\n484:       if (String(err.message || err).toLowerCase().includes('permission')) {\n485:         alert('Vault write permission blocked by remote storage policy.');\n486:       } else {\n487:         alert('Error clearing records: ' + err.message);\n488:       }\n489:     }\n490:   } else if (action === 'resetLock') {\n491:     $('reset-status-msg').textContent = 'Resetting...';\n492:     $('reset-status-msg').style.color = 'var(--mu)';\n493:     const nextEpoch = Date.now();\n494:     try {\n495:       await EncryptedLocalDB.patchField(quizId, 'lockEpoch', nextEpoch);\n496:       currentLockEpoch = nextEpoch;\n497:       try { localStorage.removeItem('ds_quiz_lock_' + quizId); } catch (e) {}\n498:       $('reset-status-msg').textContent = 'Student response lock reset! Locked devices will unlock on reload.';\n499:       $('reset-status-msg').style.color = 'var(--ok)';\n500:     } catch (err) {\n501:       $('reset-status-msg').textContent = 'Error resetting lock: ' + err.message;\n502:       $('reset-status-msg').style.color = 'var(--bad)';\n503:     }\n504:   }\n505: };\n506: \n507: $('opt-btn').onclick = () => {\n508:   $('options-panel').classList.add('open');\n509:   $('edge-overlay').classList.add('open');\n510: };","truncated_fields":["content"]}
