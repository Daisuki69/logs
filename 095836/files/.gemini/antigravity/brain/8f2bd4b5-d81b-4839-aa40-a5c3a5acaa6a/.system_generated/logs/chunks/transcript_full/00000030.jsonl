> {\n    $('status-msg').textContent = 'Error saving: ' + err.message;\n    $('status-msg').style.color = 'var(--bad)';\n  });\n};\n\nlet cachedTemplateHtml = null;\nfunction preloadTemplate() {\n  EncryptedLocalDB.readQuiz(_dec(_vT, 87)).then(doc => {\n    if (doc && doc.html) cachedTemplateHtml = doc.html;\n  }).catch(() => {});\n  _req('index.html').then(r => r.text()).then(t => {\n    if (!cachedTemplateHtml) cachedTemplateHtml = t;\n  }).catch(() => {});\n}\npreloadTemplate();\n\nfunction injectVault(tplHtml) {\n  const payload = buildQuizPayload();\n  if (!payload.questions.length && !payload.title) return tplHtml;\n  const token = sealPayload(payload);\n  return tplHtml.replace(/(<script\\s+id=[\"']local-db-vault[\"'][^>]*>)[\\s\\S]*?(<\\/script>)/i, '$1' + token + '$2');\n}\n\nfunction triggerDownload(html) {\n  const blob = new Blob([html], { type: 'application/octet-stream' });\n  const url = URL.createObjectURL(blob);\n  const a = document.createElement('a');\n  a.style.display = 'none';\n  a.href = url;\n  a.download = 'index.html';\n  document.body.appendChild(a);\n  a.click();\n  setTimeout(() => {\n    if (a.parentNode) a.parentNode.removeChild(a);\n    URL.revokeObjectURL(url);\n  }, 1000);\n  return url;\n}\n\nfunction finalizeDownload(rawHtml) {\n  const finalHtml = injectVault(rawHtml);\n  const directUrl = triggerDownload(finalHtml);\n  $('status-msg').innerHTML = 'Downloaded index.html successfully! If download did not start, <a href=\"' + directUrl + '\" download=\"index.html\" style=\"color:var(--pr);text-decoration:underline\">click here</a>.';\n  $('status-msg').style.color = 'var(--ok)';\n}"}}]}
