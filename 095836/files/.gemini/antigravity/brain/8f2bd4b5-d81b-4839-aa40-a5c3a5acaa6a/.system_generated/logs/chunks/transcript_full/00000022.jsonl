{"step_index":1068,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T21:27:31Z","content":"Created At: 2026-11-11T05:27:31+08:00\nCompleted At: 2026-11-11T05:27:32+08:00\nCreated At: 2026-11-11T05:27:31+08:00\nCompleted At: 2026-11-11T05:27:32+08:00\nShowing lines 495-615 of 806\n495:       const n = $('nm').value.trim(), s = $('sc').value.trim();\n496:       if (!n || !s) {\n497:         $('err').textContent = 'Please enter your name and section first.';\n498:         return;\n499:       }\n500:       try {\n501:         if (localStorage.getItem(LOCK)) {\n502:           showLock();\n503:           return;\n504:         }\n505:         localStorage.setItem(LOCK, JSON.stringify({ state: 'started', n, s, ts: Date.now(), epoch: Number(quizData && quizData.lockEpoch) || 0 }));\n506:       } catch (e) { }\n507:       person = { n, s };\n508:       const st = quizData.settings || {};\n509:       let qSource = quizData.questions || [];\n510:       if (st.randomizeQuestions) {\n511:         qSource = shuffle(qSource);\n512:       }\n513:       items = qSource.map(item => {\n514:         const choices = [\n515:           { t: item.correct, c: true },\n516:           ...(item.wrongs || []).map(w => ({ t: w, c: false }))\n517:         ];\n518:         return {\n519:           q: item.q,\n520:           e: item.explanation || \"\",\n521:           opts: st.randomizeAnswers ? shuffle(choices) : choices\n522:         };\n523:       });\n524:       idx = 0;\n525:       answers = [];\n526:       switches = 0;\n527:       running = true;\n528:       startedAt = Date.now();\n529:       $('start').classList.add('hide');\n530:       $('exam').classList.remove('hide');\n531:       show();\n532:     };\n533: \n534:     function show() {\n535:       const it = items[idx];\n536:       sel = null;\n537:       const st = quizData.settings || {};\n538:       $('prog').textContent = 'Question ' + (idx + 1) + ' / ' + items.length;\n539:       if (st.enableTabViolation !== false) {\n540:         $('sw').textContent = 'Violations: ' + switches;\n541:       } else {\n542:         $('sw').textContent = '';\n543:       }\n544:       $('q').textContent = (idx + 1) + '. ' + it.q;\n545:       const box = $('opts');\n546:       box.innerHTML = '';\n547:       it.opts.forEach((o, k) => {\n548:         const b = document.createElement('button');\n549:         b.className = 'opt';\n550:         b.textContent = String.fromCharCode(65 + k) + '. ' + o.t;\n551:         b.onclick = () => {\n552:           sel = k;\n553:           [...box.children].forEach((c, j) => c.classList.toggle('sel', j === k));\n554:         };\n555:         box.appendChild(b);\n556:       });\n557:       $('nx').textContent = idx === items.length - 1 ? 'Finish' : 'Next';\n558:       if (st.enableTimer !== false) {\n559:         $('pbar').classList.remove('hide');\n560:         $('tm').classList.remove('hide');\n561:         const secs = st.timePerQuestion || 20;\n562:         deadline = Date.now() + secs * 1000;\n563:         clearInterval(iv);\n564:         iv = setInterval(() => tick(secs), 100);\n565:         tick(secs);\n566:       } else {\n567:         $('pbar').classList.add('hide');\n568:         $('tm').classList.add('hide');\n569:         clearInterval(iv);\n570:       }\n571:     }\n572: \n573:     function tick(secs) {\n574:       const left = Math.max(0, deadline - Date.now());\n575:       $('tm').textContent = Math.ceil(left / 1000) + 's';\n576:       $('tb').style.width = (left / (secs * 1000) * 100) + '%';\n577:       $('tb').classList.toggle('low', left < 6000);\n578:       if (left <= 0) next();\n579:     }\n580: \n581:     function next() {\n582:       clearInterval(iv);\n583:       answers[idx] = sel;\n584:       if (idx < items.length - 1) {\n585:         idx++;\n586:         show();\n587:       } else {\n588:         finish();\n589:       }\n590:     }\n591:     $('nx').onclick = next;\n592: \n593:     function violation() {\n594:       const st = quizData.settings || {};\n595:       if (!running || away || st.enableTabViolation === false) return;\n596:       away = true;\n597:       switches++;\n598:       $('sw').textContent = 'Violations: ' + switches;\n599:       $('wc').textContent = switches;\n600:       $('warn').classList.remove('hide');\n601:     }\n602:     document.addEventListener('visibilitychange', () => {\n603:       document.hidden ? violation() : (away = false);\n604:     });\n605:     window.addEventListener('blur', violation);\n606:     window.addEventListener('focus', () => { away = false; });\n607:     $('wbtn').onclick = () => {\n608:       $('warn').classList.add('hide');\n609:     };\n610: \n611:     function finish() {\n612:       if (!running) return;\n613:       running = false;\n614:       clearInterval(iv);\n615:       let raw = 0;"}
