,\n157:     { q: \"What is the output?\\nint x = 2;\\nswitch (x) {\\n  case 1: printf(\\\"A\\\");\\n  case 2: printf(\\\"B\\\");\\n  case 3: printf(\\\"C\\\");\\n}\", correct: \"BC\", wrongs: [\"B\", \"C\", \"ABC\"], explanation: \"No break statements, so execution starts \n<truncated 2543 bytes>\ny can be strings\"], explanation: \"The compiler needs constant integer or character values to build the jump table.\" },\n167:     { q: \"What is the output?\\nint x = 5;\\nswitch (x % 2) {\\n  case 0: printf(\\\"Even\\\"); break;\\n  case 1: printf(\\\"Odd\\\"); break;\\n}\", correct: \"Odd\", wrongs: [\"Even\", \"EvenOdd\", \"Nothing is printed\"], explanation: \"5 % 2 is 1, so case 1 runs.\" },\n168:     { q: \"What is the output?\\nint x = 1;\\nswitch (x) {\\n  default: printf(\\\"D\\\");\\n  case 1: printf(\\\"1\\\"); break;\\n  case 2: printf(\\\"2\\\");\\n}\", correct: \"1\", wrongs: [\"D1\", \"D\", \"12\"], explanation: \"x matches case 1 directly, so default is skipped. Only 1 is printed, then break.\" },\n169:     { q: \"When is switch preferred over an if-else if chain?\", correct: \"Comparing one variable against several constant values\", wrongs: [\"Testing ranges like x > 10\", \"Comparing strings\", \"Evaluating floating-point conditions\"], explanation: \"switch is designed for equality checks of one integral value against constants. It cannot test ranges.\" },\n170:     { q: \"What is the value printed?\\nint a = 1;\\nswitch (a) {\\n  case 1: a++;\\n  case 2: a += 2; break;\\n  case 3: a = 10;\\n}\\nprintf(\\\"%d\\\", a);\", correct: \"4\", wrongs: [\"3\", \"2\", \"10\"], explanation: \"case 1 makes a = 2, falls into case 2 so a = 4, then break.\" },\n171:     { q: \"Which is the correct switch syntax?\", correct: \"switch (x) { case 1: printf(\\\"One\\\"); break; }\", wrongs: [\"switch x { case 1: printf(\\\"One\\\"); break; }\", \"switch (x) { case 1 printf(\\\"One\\\"); break; }\", \"switch (x) { case(1) = printf(\\\"One\\\"); }\"], explanation: \"The expression goes in parentheses and each case label ends with a colon.\" },\n172:     { q: \"Can a switch statement be nested inside another switch statement in C?\", correct: \"Yes\", wrongs: [\"No\", \"Only inside default\", \"Only with goto\"], explanation: \"Switch statements can be nested; each break only exits the innermost switch.\" }\n173:   ]\n174: };\n175: \n176: let db = null;\n177: try {\n178:   firebase.initializeApp(cfg);\n179:   db = firebase.firestore();\n180: } catch (e) {}","truncated_fields":["content"]}
