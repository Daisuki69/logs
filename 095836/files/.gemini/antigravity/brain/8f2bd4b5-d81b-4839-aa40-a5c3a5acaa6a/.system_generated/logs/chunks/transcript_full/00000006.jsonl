{"step_index":268,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-08T21:31:40Z","content":"Created At: 2026-11-09T05:31:40+08:00\nCompleted At: 2026-11-09T05:31:40+08:00\nShowing lines 300-450 of 672\n300:     </div>\n301:   </div>\n302: \n303:   <div id=\"warn\" class=\"warn hide\">\n304:     <div class=\"card\">\n305:       <h2 style=\"color:var(--bad)\">You left the quiz tab/window!</h2>\n306:       <p><b id=\"wp\">-1 point</b> will be deducted from your score.<br>Total violations: <b id=\"wc\">0</b></p>\n307:       <button id=\"wbtn\">Continue</button>\n308:     </div>\n309:   </div>\n310: \n311:   <script src=\"https://www.gstatic.com/firebasejs/10.14.0/firebase-app-compat.js\"></script>\n312:   <script src=\"https://www.gstatic.com/firebasejs/10.14.0/firebase-firestore-compat.js\"></script>\n313:   <script>\n314:     const cfg = {\n315:       apiKey: \"AIzaSyBkqJ9WvtXfGJt19XK7SLK9v5cJwp4EVII\",\n316:       authDomain: \"sir-jasper-quiz.firebaseapp.com\",\n317:       projectId: \"sir-jasper-quiz\",\n318:       storageBucket: \"sir-jasper-quiz.firebasestorage.app\",\n319:       messagingSenderId: \"932129654171\",\n320:       appId: \"1:932129654171:web:793aa17dd1f130a62f4d3e\"\n321:     };\n322: \n323:     const defaultQuiz = {\n324:       title: \"C Quiz: Switch Case\",\n325:       description: \"20 items • 20 seconds per question • Do not switch tabs or windows.\",\n326:       settings: {\n327:         timePerQuestion: 20,\n328:         enableTimer: true,\n329:         enableTabViolation: true,\n330:         tabViolationPenalty: 1,\n331:         randomizeQuestions: true,\n332:         randomizeAnswers: true\n333:       },\n334:       questions: [\n335:         { q: \"Which C statement selects one of many code blocks to run based on the value of an expression?\", correct: \"switch\", wrongs: [\"for\", \"while\", \"goto\"], explanation: \"switch compares one expression against a list of constant case labels and runs the matching block.\" },\n336:         { q: \"Which type of expression can be used as the controlling expression of a switch in C?\", correct: \"int or char\", wrongs: [\"float\", \"double\", \"string (char*)\"], explanation: \"switch works with integral types such as int and char, not floating-point values or strings.\" },\n337:         { q: \"Which keyword prevents execution from falling through to the next case?\", correct: \"break\", wrongs: [\"continue\", \"return 0\", \"exit\"], explanation: \"break leaves the switch block immediately after the matching case finishes.\" },\n338:         { q: \"When does the default label run?\", correct: \"When no case label matches\", wrongs: [\"Always, before the cases\", \"Only when the first case fails\", \"Only if break is missing\"], explanation: \"default is the fallback block used when no case matches the expression.\" },\n339:         { q: \"What is the output?\\nint x = 2;\\nswitch (x) {\\n  case 1: printf(\\\"A\\\");\\n  case 2: printf(\\\"B\\\");\\n  case 3: printf(\\\"C\\\");\\n}\", correct: \"BC\", wrongs: [\"B\", \"C\", \"ABC\"], explanation: \"No break statements, so execution starts at case 2 and falls through to case 3.\" },\n340:         { q: \"What is the output?\\nint x = 3;\\nswitch (x) {\\n  case 1: printf(\\\"1\\\"); break;\\n  default: printf(\\\"D\\\");\\n}\", correct: \"D\", wrongs: [\"1\", \"1D\", \"Nothing is printed\"], explanation: \"x is 3, no case matches, so default runs.\" },\n341:         { q: \"Is the default label required in a switch statement?\", correct: \"No, it is optional\", wrongs: [\"Yes, always\", \"Yes, but only with char\", \"Only if there is no break\"], explanation: \"default is optional; without it, nothing runs when no case matches.\" },\n342:         { q: \"Which case label is valid in C?\", correct: \"case 'A':\", wrongs: [\"case x:  (x is a variable)\", \"case 1.5:\", \"case \\\"A\\\":\"], explanation: \"Case labels must be integer or character constants. Variables, floats and strings are not allowed.\" },\n343:         { q: \"What is the output?\\nchar c = 'b';\\nswitch (c) {\\n  case 'a': printf(\\\"1\\\"); break;\\n  case 'b': printf(\\\"2\\\");\\n  case 'c': printf(\\\"3\\\"); break;\\n}\", correct: \"23\", wrongs: [\"2\", \"3\", \"123\"], explanation: \"case 'b' matches and prints 2, has no break, then falls into case 'c' and prints 3 before break.\" },\n344:         { q: \"What happens if two case labels in the same switch have the same constant value?\", correct: \"Compile-time error\", wrongs: [\"The first one runs\", \"The last one runs\", \"Both run\"], explanation: \"Duplicate case values are not allowed and the compiler reports an error.\" },\n345:         { q: \"Where can the default label be placed inside a switch?\", correct: \"Anywhere inside the switch\", wrongs: [\"Only at the end\", \"Only at the beginning\", \"Only after a break\"], explanation: \"default may appear in any position; it is used only when no case matches.\" },\n346:         { q: \"What is the output when x = 1?\\nswitch (x) {\\n  case 1:\\n  case 2: printf(\\\"Low\\\"); break;\\n  case 3: printf(\\\"High\\\");\\n}\", correct: \"Low\", wrongs: [\"High\", \"LowHigh\", \"Nothing is printed\"], explanation: \"Stacked labels share one block, so case 1 falls into case 2's code, which prints Low and breaks.\" },\n347:         { q: \"Which is NOT allowed as the controlling expression of a switch in C?\", correct: \"A float variable, e.g. switch(f)\", wrongs: [\"An int variable, e.g. switch(x)\", \"A char variable, e.g. switch(c)\", \"An expression, e.g. switch(x % 3)\"], explanation: \"The controlling expression must be an integer type; float values are not allowed.\" },\n348:         { q: \"Which statement about case labels is true?\", correct: \"They must be constant expressions\", wrongs: [\"They can be any variable\", \"They can be float values\", \"They can be strings\"], explanation: \"The compiler needs constant integer or character values to build the jump table.\" },\n349:         { q: \"What is the output?\\nint x = 5;\\nswitch (x % 2) {\\n  case 0: printf(\\\"Even\\\"); break;\\n  case 1: printf(\\\"Odd\\\"); break;\\n}\", correct: \"Odd\", wrongs: [\"Even\", \"EvenOdd\", \"Nothing is printed\"], explanation: \"5 % 2 is 1, so case 1 runs.\" },\n350:         { q: \"What is the output?\\nint x = 1;\\nswitch (x) {\\n  default: printf(\\\"D\\\");\\n  case 1: printf(\\\"1\\\"); break;\\n  case 2: printf(\\\"2\\\");\\n}\", correct: \"1\", wrongs: [\"D1\", \"D\", \"12\"], explanation: \"x matches case 1 directly, so default is skipped. Only 1 is printed, then break.\" },\n351:         { q: \"When is switch preferred over an if-else if chain?\", correct: \"Comparing one variable against several constant values\", wrongs: [\"Testing ranges like x > 10\", \"Comparing strings\", \"Evaluating floating-point conditions\"], explanation: \"switch is designed for equality checks of one integral value against constants. It cannot test ranges.\" },\n352:         { q: \"What is the value printed?\\nint a = 1;\\nswitch (a) {\\n  case 1: a++;\\n  case 2: a += 2; break;\\n  case 3: a = 10;\\n}\\nprintf(\\\"%d\\\", a);\", correct: \"4\", wrongs: [\"3\", \"2\", \"10\"], explanation: \"case 1 makes a = 2, falls into case 2 so a = 4, then break.\" },\n353:         { q: \"Which is the correct switch syntax?\", correct: \"switch (x) { case 1: printf(\\\"One\\\"); break; }\", wrongs: [\"switch x { case 1: printf(\\\"One\\\"); break; }\", \"switch (x) { case 1 printf(\\\"One\\\"); break; }\", \"switch (x) { case(1) = printf(\\\"One\\\"); }\"], explanation: \"The expression goes in parentheses and each case label ends with a colon.\" },\n354:         { q: \"Can a switch statement be nested inside another switch statement in C?\", correct: \"Yes\", wrongs: [\"No\", \"Only inside default\", \"Only with goto\"], explanation: \"Switch statements can be nested; each break only exits the innermost switch.\" }\n355:       ]\n356:     };\n357: \n358:     let db = null;\n359:     try {\n360:       firebase.initializeApp(cfg);\n361:       db = firebase.firestore();\n362:     } catch (e) { }\n363: \n364:     const $ = id => document.getElementById(id);\n365:     const quizId = new URLSearchParams(window.location.search).get(\"quiz\") || \"active\";\n366:     const LOCK = 'ds_quiz_lock_' + quizId;\n367: \n368:     let quizData = null;\n369:     let items = [];\n370:     let idx = 0;\n371:     let sel = null;\n372:     let answers = [];\n373:     let switches = 0;\n374:     let running = false;\n375:     let away = false;\n376:     let deadline = 0;\n377:     let iv = null;\n378:     let startedAt = 0;\n379:     let person = {};\n380: \n381:     function shuffle(arr) {\n382:       const a = [...arr];\n383:       for (let i = a.length - 1; i > 0; i--) {\n384:         const j = Math.floor(Math.random() * (i + 1));\n385:         [a[i], a[j]] = [a[j], a[i]];\n386:       }\n387:       return a;\n388:     }\n389: \n390:     function initDisplay(data) {\n391:       quizData = data;\n392:       $('title').textContent = data.title || \"Quiz\";\n393:       $('desc').textContent = data.description || \"\";\n394:       const st = data.settings || {};\n395:       if (st.enableTimer === false) {\n396:         $('r-timer').textContent = \"There is no time limit for questions.\";\n397:       } else {\n398:         $('r-timer').innerHTML = \"Each question has <b>\" + (st.timePerQuestion || 20) + \" seconds</b>. When time runs out, it moves on automatically.\";\n399:       }\n400:       if (st.enableTabViolation === false) {\n401:         $('r-tab').style.display = 'none';\n402:       } else {\n403:         const pen = st.tabViolationPenalty != null ? st.tabViolationPenalty : 1;\n404:         $('r-tab').innerHTML = \"Every alt-tab or switch to another tab/app costs <b>-\" + pen + \" point\" + (pen === 1 ? \"\" : \"s\") + \"</b>.\";\n405:         $('wp').textContent = \"-\" + pen + \" point\" + (pen === 1 ? \"\" : \"s\");\n406:       }\n407:       $('go').disabled = false;\n408:     }\n409: \n410:     function loadQuiz() {\n411:       initDisplay(defaultQuiz);\n412:       if (db) {\n413:         db.collection(\"quizzes\").doc(quizId).get().then(doc => {\n414:           if (doc.exists) {\n415:             initDisplay(doc.data());\n416:           }\n417:         }).catch(() => { });\n418:       }\n419:     }\n420:     loadQuiz();\n421: \n422:     $('go').onclick = () => {\n423:       const n = $('nm').value.trim(), s = $('sc').value.trim();\n424:       if (!n || !s) {\n425:         $('err').textContent = 'Please enter your name and section first.';\n426:         return;\n427:       }\n428:       try {\n429:         if (localStorage.getItem(LOCK)) {\n430:           showLock();\n431:           return;\n432:         }\n433:         localStorage.setItem(LOCK, JSON.stringify({ state: 'started', n, s, ts: Date.now() }));\n434:       } catch (e) { }\n435:       person = { n, s };\n436:       const st = quizData.settings || {};\n437:       let qSource = quizData.questions || [];\n438:       if (st.randomizeQuestions) {\n439:         qSource = shuffle(qSource);\n440:       }\n441:       items = qSource.map(item => {\n442:         const choices = [\n443:           { t: item.correct, c: true },\n444:           ...(item.wrongs || []).map(w => ({ t: w, c: false }))\n445:         ];\n446:         return {\n447:           q: item.q,\n448:           e: item.explanation || \"\",\n449:           opts: st.randomizeAnswers ? shuffle(choices) : choices\n450:         };"}
