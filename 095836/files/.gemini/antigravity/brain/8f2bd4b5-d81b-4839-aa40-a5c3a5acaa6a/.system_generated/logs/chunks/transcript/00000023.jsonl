tor');\\n  loadTeacherQuiz(quizId);\\n}\"","Target":"\"function loadQuizById(id, label, order) {\\n  quizId = id || 'active';\\n  currentQuizLabel = label || defaultLabelFor(quizId);\\n  currentQuizOrder = order || defaultOrderFor(quizId);\\n  try {\\n    history.replaceState(null, '', location.pathname + '?quiz=' + encodeURIComponent(quizId));\\n  } catch (e) { }\\n  $('view-dash').classList.add('hide');\\n  $('main-nav').classList.remove('hide');\\n  $('opt-btn').classList.remove('hide');\\n  $('sub-status-msg').classList.add('hide');\\n  switchTab('tab-btn-editor');\\n  loadTeacherQuiz(quizId);\\n}\""}},{"name":"edit_file","args":{"Path":"\"C:\\\\Users\\\\CxAdmin\\\\.gemini\\\\antigravity\\\\brain\\\\8f2bd4b5-d81b-4839-aa40-a5c3a5acaa6a\\\\scratch\\\\obf_tool\\\\tmp_backup\\\\teacher.html\"","Replacement":"\"document.addEventListener('visibilitychange', syncSubPoller);\\nwindow.addEventListener('popstate', e => {\\n  const st = e && e.state;\\n  const qParam = new URLSearchParams(window.location.search).get('quiz');\\n  const targetId = (st && st.quizId) || qParam;\\n  if (targetId && (!st || !st.dash)) {\\n    loadQuizById(targetId, st && st.label, st && st.quizOrder, false);\\n  } else {\\n    showDashboard(false);\\n  }\\n});\\nsyncSubViewState();\\nif (initialUrlQuiz) {\\n  loadQuizById(initialUrlQuiz, null, null, false);\\n} else {\\n  showDashboard(true);\\n}\"","Target":"\"document.addEventListener('visibilitychange', syncSubPoller);\\nsyncSubViewState();\\nif (initialUrlQuiz) {\\n  loadQuizById(initialUrlQuiz);\\n} else {\\n  showDashboard();\\n}\""}}]}
