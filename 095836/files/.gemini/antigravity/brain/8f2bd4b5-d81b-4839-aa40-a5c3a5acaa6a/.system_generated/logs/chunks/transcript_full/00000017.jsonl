{\n  const f = {};\n  for (const [k, v] of Object.entries(obj || {})) {\n    if (v !== undefined) f[k] = toStoreVal(v);\n  }\n  return f;\n}\nfunction fromStoreVal(v) {\n  if (!v) return null;\n  if ('stringValue' in v) return v.stringValue;\n  if ('integerValue' in v) return Number(v.integerValue);\n  if ('doubleValue' in v) return Number(v.doubleValue);\n  if ('booleanValue' in v) return Boolean(v.booleanValue);\n  if ('nullValue' in v) return null;\n  if ('arrayValue' in v) return (v.arrayValue.values || []).map(fromStoreVal);\n  if ('mapValue' in v) return fromStoreDoc(v.mapValue);\n  return null;\n}\nfunction fromStoreDoc(doc) {\n  const out = {};\n  const f = (doc && doc.fields) || {};\n  for (const [k, v] of Object.entries(f)) out[k] = fromStoreVal(v);\n  return out;\n}\n\n(async () => {\n  const r = await fetch('https://firestore.googleapis.com/v1/projects/sir-jasper-quiz/databases/(default)/documents/quizzes/active');\n  const rawDoc = await r.json();\n  const parsed = fromStoreDoc(rawDoc);\n  const sealed = sealPayload(parsed);\n  const unsealed = unsealPayload(sealed);\n  const reEncoded = { fields: toStoreFields(unsealed) };\n  console.log('Parsed title:', unsealed.title);\n  console.log('Sealed length:', sealed.length, 'Sealed sample:', sealed.slice(0, 32));\n  console.log('Exact round-trip match:', JSON.stringify(parsed) === JSON.stringify(unsealed));\n  console.log('Settings boolean preserved:', reEncoded.fields.settings.mapValue.fields.autoRecordQuiz);\n  console.log('Questions array preserved:', reEncoded.fields.questions.arrayValue.values.length);\n})();\n\"","WaitMsBeforeAsync":5000,"toolSummary":"Unit test cipher and REST codec against live active quiz"}}]}
