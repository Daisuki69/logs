d)';\n436:     return;\n437:   }\n438:   settingsState.tabViolationPenalty = parseInt($('pen-val').value, 10) || 0;\n439:   settingsState.timePerQuestion = parseInt($('time-val').value, 10) || 20;\n440: \n441:   const cards = $('questions-container').querySelectorAll('.q-card');\n442:   const questions = [];\n443:   cards.forEach(c => {\n444:     const q = c.querySelector('.q-text').value.trim();\n445:     const correct = c.querySelector('.q-corr').value.trim();\n446:     const w1 = c.querySelector('.q-w1').value.trim();\n447:     const w2 = c.querySelector('.q-w2').value.trim();\n448:     const w3 = c.querySelector('.q-w3').value.trim();\n449:     const exp = c.querySelector('.q-exp').value.trim();\n450:     if (q || correct) {\n451:       questions.push({\n452:         q,\n453:         correct,\n454:         wrongs: [w1, w2, w3].filter(Boolean),\n455:         explanation: exp\n456:       });\n457:     }\n458:   });\n459: \n460:   if (questions.length === 0) {"}
