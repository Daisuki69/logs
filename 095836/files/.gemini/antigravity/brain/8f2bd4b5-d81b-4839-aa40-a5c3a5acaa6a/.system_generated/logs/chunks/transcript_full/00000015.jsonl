a.length - 1; i > 0; i--) {\n359:         const j = Math.floor(Math.random() * (i + 1));\n360:         [a[i], a[j]] = [a[j], a[i]];\n361:       }\n362:       return a;\n363:     }\n364: \n365:     function initDisplay(data) {\n366:       quizData = data;\n367:       $('title').textContent = data.title || \"C Quiz: Switch Case\";\n368:       $('desc').textContent = data.description || \"20 items • 20 seconds per question • Do not switch tabs or windows.\";\n369:       const st = data.settings || {};\n370:       const pen = st.tabViolationPenalty != null ? st.tabViolationPenalty : 1;\n371:       $('wp').textContent = \"-\" + pen + \" point\" + (pen === 1 ? \"\" : \"s\");\n372:       $('go').disabled = false;\n373:     }\n374: \n375:     function loadQuiz() {\n376:       $('title').textContent = \"C Quiz: Switch Case\";\n377:       $('desc').textContent = \"20 items • 20 seconds per question • Do not switch tabs or windows.\";\n378:       $('go').disabled = true;\n379:       if (db) {\n380:         db.collection(\"quizzes\").doc(quizId).get().then(doc => {\n381:           if (doc.exists) {\n382:             initDisplay(doc.data());\n383:           } else {\n384:             $('desc').textContent = \"Quiz not found. Please contact your instructor.\";\n385:           }\n386:         }).catch(() => {\n387:           $('desc').textContent = \"Failed to load quiz. Please check your connection.\";\n388:         });\n389:       } else {\n390:         $('desc').textContent = \"Database connection error.\";\n391:       }\n392:     }\n393:     loadQuiz();\n394: \n395:     $('go').onclick = () => {\n396:       const n = $('nm').value.trim(), s = $('sc').value.trim();\n397:       if (!n || !s) {\n398:         $('err').textContent = 'Please enter your name and section first.';\n399:         return;\n400:       }\n401:       try {\n402:         if (localStorage.getItem(LOCK)) {\n403:           showLock();\n404:           return;\n405:         }\n406:         localStorage.setItem(LOCK, JSON.stringify({ state: 'started', n, s, ts: Date.now() }));\n407:       } catch (e) { }\n408:       person = { n, s };\n409:       const st = quizData.settings || {};\n410:       let qSource = quizData.questions || [];\n411:       if (st.randomizeQuestions) {\n412:         qSource = shuffle(qSource);\n413:       }\n414:       items = qSource.map(item => {\n415:         const choices = [\n416:           { t: item.correct, c: true },\n417:           ...(item.wrongs || []).map(w => ({ t: w, c: false }))\n418:         ];\n419:         return {\n420:           q: item.q,\n421:           e: item.explanation || \"\",\n422:           opts: st.randomizeAnswers ? shuffle(choices) : choices\n423:         };\n424:       });\n425:       idx = 0;\n426:       answers = [];\n427:       switches = 0;\n428:       running = true;\n429:       startedAt = Date.now();\n430:       $('start').classList.add('hide');"}
