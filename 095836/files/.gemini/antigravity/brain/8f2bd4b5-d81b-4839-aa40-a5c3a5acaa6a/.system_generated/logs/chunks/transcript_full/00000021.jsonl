  const done = () => { $('cp').textContent = 'Copied!'; };\n702:         const manual = () => {\n703:           if (!$('codebox')) {\n704:             const t = document.createElement('textarea');\n705:             t.id = 'codebox';\n706:             t.readOnly = true;\n707:             t.value = rec.code;\n708:             t.style.cssText = 'width:100%;height:90px;margin-top:10px';\n709:             $('cp').parentNode.after(t);\n710:           }\n711:           $('codebox').select();\n712:         };\n713:         try {\n714:           navigator.clipboard.writeText(rec.code).then(done).catch(manual);\n715:         } catch (e) {\n716:           manual();\n717:         }\n718:       };\n719:       window.scrollTo(0, 0);\n720:     }\n721: \n722:     function dlRec(rec) {\n723:       const blob = new Blob([JSON.stringify(rec, null, 2)], { type: 'application/json' });\n724:       const a = document.createElement('a');\n725:       a.href = URL.createObjectURL(blob);\n726:       a.download = 'result_' + rec.n.replace(/\\W+/g, '_') + '_' + rec.s.replace(/\\W+/g, '_') + '.json';\n727:       a.click();\n728:     }\n729: \n730:     function showLock() {\n731:       let L = null;\n732:       try { L = JSON.parse(localStorage.getItem(LOCK)); } catch (e) { }\n733:       $('start').classList.add('hide');\n734:       $('exam').classList.add('hide');\n735:       $('res').classList.add('hide');\n736:       $('lock').classList.remove('hide');\n737:       if (L && L.state === 'done') {\n738:         $('lk2').textContent = 'Your response has been recorded for ' + L.rec.n + ' (' + L.rec.s + '). Please wait for your instructor to announce the results.';\n739:         const isAuto = !quizData || !quizData.settings || quizData.settings.autoRecordQuiz !== false;\n740:         if (!isAuto) {\n741:           $('lkdl').classList.remove('hide');\n742:           $('lkdl').onclick = () => dlRec(L.rec);\n743:         } else {\n744:           $('lkdl').classList.add('hide');\n745:         }\n746:       } else if (L) {\n747:         $('lk2').textContent = 'A quiz session for ' + L.n + ' (' + L.s + ') was already started on this device and cannot be reopened. Please inform your instructor.';\n748:       }\n749:     }\n750: \n751:     function chkReset() {\n752:       try {\n753:         if (location.hash === '#reset-quiz') {\n754:           localStorage.removeItem(LOCK);\n755:           history.replaceState(null, '', location.pathname + location.search);\n756:           location.reload();\n757:         }\n758:       } catch (e) { }\n759:     }\n760:     window.addEventListener('hashchange', chkReset);\n761:     chkReset();\n762:     try {\n763:       if (localStorage.getItem(LOCK)) showLock();\n764:     } catch (e) { }\n765:     document.addEventListener('contextmenu', e => {"}
