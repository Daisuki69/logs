age);\n419: db.collection(\"quizzes\").doc(quizId).get().then(doc => {\n469: db.collection(\"quizzes\").doc(quizId).set({\n491: db.collection(\"quizzes\").doc(\"template\").get().then(snap => {\n530: const fetchRemote = db ? db.collection(\"quizzes\").doc(\"template\").get().then(s => s.exists && s.data().html ? s.data().html : null) : Promise.resolve(null);\n552: function initSubmissionsFeed() {\n554: db.collection(\"quizzes\").doc(quizId).collection(\"submissions\").orderBy(\"submittedAt\", \"desc\").onSnapshot(snap => {\n558: feed.innerHTML = '<p style=\"text-align:center;padding:24px;color:var(--mu);margin:0\">No submissions recorded yet.</p>';\n574: $('sub-feed').innerHTML = '<p style=\"color:var(--bad);padding:14px;margin:0\">Failed to load submissions: ' + err.message + '</p>';\n577: initSubmissionsFeed();\n"}
