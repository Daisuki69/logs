rial,sans-serif;background:var(--bg);color:var(--tx);padding:16px}\r\n.wrap{max-width:760px;margin:0 auto}\r\n.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:20px;margin-bottom:14px}\r\nh1{font-size:1.4rem;margin:0 0 6px}h2{font-size:1.1rem;margin:0 0 10px}\r\np,li{color:var(--mu);line-height:1.5}\r\ninput,textarea{width:100%;padding:12px;margin:6px 0 14px;border:1px solid var(--bd);border-radius:10px;font-size:1rem;background:var(--bg);color:var(--tx);font-family:inherit}\r\nbutton{font-size:1rem;padding:12px 20px;border:0;border-radius:10px;background:var(--pr);color:#fff;cursor:pointer;font-weight:600}\r\nbutton.sec{background:transparent;color:var(--pr);border:1px solid var(--pr)}\r\nbutton.danger{background:transparent;color:var(--bad);border:1px solid var(--bad)}\r\n.hide{display:none!important}\r\n.top{display:flex;justify-content:space-between;align-items:center;font-weight:600;margin-bottom:8px}\r\n.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}\r\n.opt-toggle{display:flex;justify-content:space-between;align-items:center;padding:12px;background:var(--bg);border:1px solid var(--bd);border-radius:10px;margin-bottom:10px}\r\n.badge{font-size:0.8rem;padding:3px 8px;border-radius:12px;background:var(--bd);color:var(--tx);font-weight:700}\r\n.badge.on{background:var(--ok);color:#fff}\r\n.badge.off{background:var(--mu);color:#fff}\r\n.q-card{border-left:4px solid var(--pr)}\r\n.correct-box{border-color:var(--ok)!important}\r\n.wrong-box{border-color:var(--bd)}\r\n.floating-add{position:sticky;bottom:16px;display:flex;justify-content:center;z-index:5}\r\n.plus-btn{border-radius:30px;padding:14px 28px;box-shadow:0 4px 14px rgba(0,0,0,0.15);font-size:1.1rem;display:flex;align-items:center;gap:8px}\r\n.edge-tab-btn{position:fixed;right:0;top:120px;z-index:90;background:var(--pr);color:#fff;border:none;border-radius:10px 0 0 10px;padding:12px 10px;cursor:pointer;box-shadow:-2px 3px 10px rgba(0,0,0,0.18);display:flex;align-items:center;justify-content:center}\r\n.edge-panel{position:fixed;top:0;right:-400px;width:340px;max-width:88vw;height:100vh;background:var(--card);border-left:1px solid var(--bd);box-shadow:-4px 0 24px rgba(0,0,0,0.2);z-index:200;transition:right .25s ease;padding:20px;overflow-y:auto;box-sizing:border-box}\r\n.edge-panel.open{right:0}\r\n.edge-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:190;opacity:0;pointer-events:none;transition:opacity .25s ease}\r\n.edge-overlay.open{opacity:1;pointer-events:auto}\r\n</style>\r\n</head>\r\n<body>\r\n<button id=\"opt-btn\" class=\"edge-tab-btn\" type=\"button\" aria-label=\"Quiz Options\" title=\"Quiz Options\">\r\n  <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n    <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\r\n    <path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1\n<truncated 33494 of 43384 bytes from the middle of the output>\nel.style.color = 'var(--mu)';\r\n  w1Label.textContent = 'Wrong Answer 1';\r\n  const w1Input = document.createElement('input');\r\n  w1Input.className = 'wrong-box q-w1';\r\n  w1Input.placeholder = 'Tap and type wrong answer 1...';\r\n  w1Input.value = wrongs[0] || '';\r\n  w1Label.appendChild(w1Input);\r\n\r\n  const w2Label = document.createElement('label');\r\n  w2Label.style.color = 'var(--mu)';\r\n  w2Label.textContent = 'Wrong Answer 2';\r\n  const w2Input = document.createElement('input');\r\n  w2Input.className = 'wrong-box q-w2';\r\n  w2Input.placeholder = 'Tap and type wrong answer 2...';\r\n  w2Input.value = wrongs[1] || '';\r\n  w2Label.appendChild(w2Input);\r\n\r\n  const w3Label = document.createElement('label');\r\n  w3Label.style.color = 'var(--mu)';\r\n  w3Label.textContent = 'Wrong Answer 3';\r\n  const w3Input = document.createElement('input');\r\n  w3Input.className = 'wrong-box q-w3';\r\n  w3Input.placeholder = 'Tap and type wrong answer 3...';\r\n  w3Input.value = wrongs[2] || '';\r\n  w3Label.appendChild(w3Input);\r\n\r\n  const expLabel = document.createElement('label');\r\n  expLabel.style.color = 'var(--mu)';\r\n  expLabel.textContent = 'Explanation (Optional)';\r\n  const expInput = document.createElement('input');\r\n  expInput.className = 'q-exp';\r\n  expInput.placeholder = 'Tap and type explanation shown in feedback...';\r\n  expInput.value = data.explanation || '';\r\n  expLabel.appendChild(expInput);\r\n\r\n  card.append(top, qLabel, cLabel, w1Label, w2Label, w3Label, expLabel);\r\n  return card;\r\n}\r\n\r\nfunction renumberCards() {\r\n  const cards = $('questions-container').querySelectorAll('.q-card');\r\n  cards.forEach((c, idx) => {\r\n    const lbl = c.querySelector('.q-num-label');\r\n    if (lbl) lbl.textContent = 'Question ' + (idx + 1);\r\n  });\r\n}\r\n\r\n$('add-q-btn').onclick = () => {\r\n  const container = $('questions-container');\r\n  const count = container.querySelectorAll('.q-card').length + 1;\r\n  const newCard = createQuestionCard({}, count);\r\n  container.appendChild(newCard);\r\n  newCard.scrollIntoView({ behavior: 'smooth' });\r\n};\r\n\r\nfunction populateQuizData(quiz) {\r\n  $('qtitle').value = quiz.title || '';\r\n  $('qdesc').value = quiz.description || '';\r\n  if (quiz.settings) {\r\n    settingsState = { ...settingsState, ...quiz.settings };\r\n  }\r\n  syncOptionsUI();\r\n  const container = $('questions-container');\r\n  container.innerHTML = '';\r\n  (quiz.questions || []).forEach((q, idx) => {\r\n    container.appendChild(createQuestionCard(q, idx + 1));\r\n  });\r\n  if ((quiz.questions || []).length === 0) {\r\n    container.appendChild(createQuestionCard({}, 1));\r\n  }\r\n}\r\n\r\nfunction loadTeacherQuiz() {\r\n  populateQuizData(defaultQuiz);\r\n  if (db) {\r\n    db.collection(\"quizzes\").doc(quizId).get().then(doc => {\r\n      if (doc.exists) {\r\n        populateQuizData(doc.data());\r\n        $('status-msg').textContent = 'Loaded active quiz Locally.';\r\n        $('status-msg').style.color = 'var(--ok)';\r\n      }\r\n    }).catch(() => {});\r\n  }\r\n}\r\nloadTeacherQuiz();\r\n\r\n$('save-btn').onclick = () => {\r\n  const title = $('qtitle').value.trim();\r\n  const desc = $('qdesc').value.trim();\r\n  if (!title) {\r\n    $('status-msg').textContent = 'Please enter a quiz title.';\r\n    $('status-msg').style.color = 'var(--bad)';\r\n    return;\r\n  }\r\n  settingsState.tabViolationPenalty = parseInt($('pen-val').value, 10) || 0;\r\n  settingsState.timePerQuestion = parseInt($('time-val').value, 10) || 20;\r\n\r\n  const cards = $('questions-container').querySelectorAll('.q-card');\r\n  const questions = [];\r\n  cards.forEach(c => {\r\n    const q = c.querySelector('.q-text').value.trim();\r\n    const correct = c.querySelector('.q-corr').value.trim();\r\n    const w1 = c.querySelector('.q-w1').value.trim();\r\n    const w2 = c.querySelector('.q-w2').value.trim();\r\n    const w3 = c.querySelector('.q-w3').value.trim();\r\n    const exp = c.querySelector('.q-exp').value.trim();\r\n    if (q || correct) {\r\n      questions.push({\r\n        q,\r\n        correct,\r\n        wrongs: [w1, w2, w3].filter(Boolean),\r\n        explanation: exp\r\n      });\r\n    }\r\n  });\r\n\r\n  if (questions.length === 0) {\r\n    $('status-msg').textContent = 'Please add at least one question.';\r\n    $('status-msg').style.color = 'var(--bad)';\r\n    return;\r\n  }\r\n\r\n  $('status-msg').textContent = 'Saving...';\r\n  $('status-msg').style.color = 'var(--mu)';\r\n  if (db) {\r\n    db.collection(\"quizzes\").doc(quizId).set({\r\n      title,\r\n      description: desc,\r\n      settings: settingsState,\r\n      questions,\r\n      updatedAt: Date.now()\r\n    }).then(() => {\r\n      $('status-msg').textContent = 'Saved Successfully to Student Quiz File! Quiz is live.';\r\n      $('status-msg').style.color = 'var(--ok)';\r\n    }).catch(err => {\r\n      $('status-msg').textContent = 'Error saving: ' + err.message;\r\n      $('status-msg').style.color = 'var(--bad)';\r\n    });\r\n  } else {\r\n    $('status-msg').textContent = 'Database is not initialized.';\r\n    $('status-msg').style.color = 'var(--bad)';\r\n  }\r\n};\r\n</script>\r\n\r\n\r\n</body></html>\r\n"}
