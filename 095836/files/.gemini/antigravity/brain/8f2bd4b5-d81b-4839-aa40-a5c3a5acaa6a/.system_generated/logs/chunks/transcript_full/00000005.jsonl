ckground:var(--pr);color:#fff;cursor:pointer;font-weight:600}\r\nbutton.sec{background:transparent;color:var(--pr);border:1px solid var(--pr)}\r\nbutton.danger{background:transparent;color:var(--bad);border:1px solid var(--bad)}\r\n.hide{display:none!important}\r\n.top{display:flex;justify-content:space-between;align-items:center;font-weight:600;margin-bottom:8px}\r\n.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}\r\n.opt-toggle{display:flex;justify-content:space-between;align-items:center;padding:12px;background:var(--bg);border:1px solid var(--bd);border-radius:10px;margin-bottom:10px}\r\n.badge{font-size:0.8rem;padding:3px 8px;border-radius:12px;background:var(--bd);color:var(--tx);font-weight:700}\r\n.badge.on{background:var(--ok);color:#fff}\r\n.badge.off{background:var(--mu);color:#fff}\r\n.q-card{border-left:4px solid var(--pr)}\r\n.correct-box{border-color:var(--ok)!important}\r\n.wrong-box{border-color:var(--bd)}\r\n.floating-add{position:sticky;bottom:16px;display:flex;justify-content:center;z-index:5}\r\n.plus-btn{border-radius:30px;padding:14px 28px;box-shadow:0 4px 14px rgba(0,0,0,0.15);font-size:1.1rem;display:flex;align-items:center;gap:8px}\r\n.edge-tab-btn{position:fixed;right:0;top:120px;z-index:90;background:var(--pr);color:#fff;border:none;border-radius:10px 0 0 10px;padding:12px 10px;cursor:pointer;box-shadow:-2px 3px 10px rgba(0,0,0,0.18);display:flex;align-items:center;justify-content:center}\r\n.edge-panel{position:fixed;top:0;right:-400px;width:340px;max-width:88vw;height:100vh;background:var(--card);border-left:1px solid var(--bd);box-shadow:-4px 0 24px rgba(0,0,0,0.2);z-index:200;transition:right .25s ease;padding:20px;overflow-y:auto;box-sizing:border-box}\r\n.edge-panel.open{right:0}\r\n.edge-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:190;opacity:0;pointer-events:none;transition:opacity .25s ease}\r\n.edge-overlay.open{opacity:1;pointer-events:auto}\r\n</style>\r\n</head>\r\n<body>\r\n<button id=\"op