q-corr').value.trim();\n    const w1 = c.querySelector('.q-w1').value.trim();\n    const w2 = c.querySelector('.q-w2').value.trim();\n    const w3 = c.querySelector('.q-w3').value.trim();\n    const exp = c.querySelector('.q-exp').value.trim();\n    if (q || correct) {\n      questions.push({\n        q,\n        correct,\n        wrongs: [w1, w2, w3].filter(Boolean),\n        explanation: exp\n      });\n    }\n  });\n\n  if (questions.length === 0) {\n    $('status-msg').textContent = 'Please add at least one question.';\n    $('status-msg').style.color = 'var(--bad)';\n    return;\n  }\n\n  $('status-msg').textContent = 'Saving to Firebase...';\n  $('status-msg').style.color = 'var(--mu)';\n  if (db) {\n    db.collection(\"quizzes\").doc(quizId).set({\n      title,\n      description: desc,\n      settings: settingsState,\n      questions,\n      updatedAt: Date.now()\n    }).then(() => {\n      $('status-msg').textContent = 'Saved Successfully to Student Quiz File! Quiz is live.';\n      $('status-msg').style.color = 'var(--ok)';\n    }).catch(err => {\n      $('status-msg').textContent = 'Error saving: ' + err.message;\n      $('status-msg').style.color = 'var(--bad)';\n    });\n  } else {\n    $('status-msg').textContent = 'Firebase is not initialized.';\n    $('status-msg').style.color = 'var(--bad)';\n  }\n};","Target":"$('load-def-btn').onclick = () => {\n  populateQuizData(defaultQuiz);\n  $('status-msg').textContent = 'Default 20 C quiz questions loaded.';\n  $('status-msg').style.color = 'var(--pr)';\n};\n\n$('save-btn').onclick = () => {\n  const title = $('qtitle').value.trim();\n  const desc = $('qdesc').value.trim();\n  if (!title) {\n    $('status-msg').textContent = 'Please enter a quiz title.';\n    $('status-msg').style.color = 'var(--bad)';\n    return;\n  }\n  settingsState.tabViolationPenalty = parseInt($('pen-val').value, 10) || 0;\n  settingsState.timePerQuestion = parseInt($('time-val').value, 10) || 20;\n\n  const cards = $('questions-container').querySelectorAll('.q-card');\n  const questions = [];\n  cards.forEach(c => {\n    const q = c.querySelector('.q-text').value.trim();\n    const correct = c.querySelector('.q-corr').value.trim();\n    const w1 = c.querySelector('.q-w1').value.trim();\n    const w2 = c.querySelector('.q-w2').value.trim();\n    const w3 = c.querySelector('.q-w3').value.trim();\n    const exp = c.querySelector('.q-exp').value.trim();\n    if (q || correct) {\n      questions.push({\n        q,\n        correct,\n        wrongs: [w1, w2, w3].filter(Boolean),\n        explanation: exp\n      });\n    }\n  });\n\n  if (questions.length === 0) {\n    $('status-msg').textContent = 'Please add at least one question.';\n    $('status-msg').style.color = 'var(--bad)';\n    return;\n  }\n\n  $('status-msg').textContent = 'Saving to Firebase...';\n  $('status-msg').style.color = 'var(--mu)';\n  if (db) {\n    db.collection(\"quizzes\").doc(quizId).set({\n      title,\n      description: desc,\n      settings: settingsState,\n      questions,\n      updatedAt: Date.now()\n    }).then(() => {\n      $('status-msg').textContent = 'Saved successfully to Firebase! Quiz is live.';\n      $('status-msg').style.color = 'var(--ok)';\n    }).catch(err => {\n      $('status-msg').textContent = 'Error saving: ' + err.message;\n      $('status-msg').style.color = 'var(--bad)';\n    });\n  } else {\n    $('status-msg').textContent = 'Firebase is not initialized.';\n    $('status-msg').style.color = 'var(--bad)';\n  }\n};"}}]}
