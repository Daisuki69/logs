ement('a');\n620:       a.href = URL.createObjectURL(blob);\n621:       a.download = 'result_' + rec.n.replace(/\\W+/g, '_') + '_' + rec.s.replace(/\\W+/g, '_') + '.json';\n622:       a.click();\n623:     }\n624: \n625:     function showLock() {\n626:       let L = null;\n627:       try { L = JSON.parse(localStorage.getItem(LOCK)); } catch (e) { }\n628:       $('start').classList.add('hide');\n629:       $('exam').classList.add('hide');\n630:       $('res').classList.add('hide');\n631:       $('lock').classList.remove('hide');\n632:       if (L && L.state === 'done') {\n633:         $('lk2').textContent = 'Your response has been recorded for ' + L.rec.n + ' (' + L.rec.s + '). Please wait for your instructor to announce the results.';\n634:         $('lkdl').classList.remove('hide');\n635:         $('lkdl').onclick = () => dlRec(L.rec);\n636:       } else if (L) {\n637:         $('lk2').textContent = 'A quiz session for ' + L.n + ' (' + L.s + ') was already started on this device and cannot be reopened. Please inform your instructor.';\n638:       }\n639:     }\n640: \n641:     function chkReset() {\n642:       try {\n643:         if (location.hash === '#reset-quiz') {\n644:           localStorage.removeItem(LOCK);\n645:           history.replaceState(null, '', location.pathname + location.search);\n646:           location.reload();\n647:         }\n648:       } catch (e) { }\n649:     }\n650:     window.addEventListener('hashchange', chkReset);\n651:     chkReset();\n652:     try {\n653:       if (localStorage.getItem(LOCK)) showLock();\n654:     } catch (e) { }\n655:   </script>\n656: </body>\n657: \n658: </html>\n(no newline at end of file)"}
