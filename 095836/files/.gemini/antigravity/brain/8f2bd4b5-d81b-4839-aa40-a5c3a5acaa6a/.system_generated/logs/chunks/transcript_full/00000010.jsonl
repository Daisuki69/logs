res.text();\n      }\n    } catch (e) {}\n  }\n  if (html) {\n    const blob = new Blob([html], { type: 'text/html' });\n    const a = document.createElement('a');\n    a.href = URL.createObjectURL(blob);\n    a.download = 'index.html';\n    a.click();\n    $('status-msg').textContent = 'Downloaded index.html successfully!';\n    $('status-msg').style.color = 'var(--ok)';\n  } else {\n    $('status-msg').textContent = 'Could not load quiz template.';\n    $('status-msg').style.color = 'var(--bad)';\n  }\n};"}}]}
