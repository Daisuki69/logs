1:           const remoteEpoch = Number(data && data.lockEpoch) || 0;\n472:           if (remoteEpoch > localEpoch) {\n473:             localStorage.removeItem(LOCK);\n474:             $('lock').classList.add('hide');\n475:             $('start').classList.remove('hide');\n476:           } else {\n477:             quizData = data;\n478:             showLock();\n479:             return;\n480:           }\n481:         }\n482:       } catch (e) { }\n483:       initDisplay(data);\n484:     }\n485: \n486:     function loadQuiz() {\n487:       $('title').textContent = \"C Quiz: Switch Case\";\n488:       $('desc').textContent = \"20 items • 20 seconds per question • Do not switch tabs or windows.\";\n489:       $('go').disabled = true;\n490:       const vEl = $('local-db-vault');\n491:       const vToken = vEl ? vEl.textContent.trim() : '';\n492:       EncryptedLocalDB.readQuiz(quizId).then(data => {\n493:         if (data) {\n494:           checkRemoteUnlock(data);\n495:         } else if (vToken) {\n496:           checkRemoteUnlock(unsealPayload(vToken));\n497:         } else {\n498:           $('desc').textContent = \"Quiz not found. Please contact your instructor.\";\n499:         }\n500:       }).catch(() => {\n501:         if (vToken) {\n502:           try {\n503:             checkRemoteUnlock(unsealPayload(vToken));\n504:             return;\n505:           } catch (e) { }\n506:         }\n507:         $('desc').textContent = \"Failed to load quiz. Please check your connection.\";\n508:       });\n509:     }\n510:     loadQuiz();\n511: \n512:     $('go').onclick = () => {\n513:       const n = $('nm').value.trim(), s = $('sc').value.trim();\n514:       if (!n || !s) {\n515:         $('err').textContent = 'Please enter your name and section first.';\n516:         return;\n517:       }\n518:       try {\n519:         if (localStorage.getItem(LOCK)) {\n520:           showLock();\n521:           return;\n522:         }\n523:         localStorage.setItem(LOCK, JSON.stringify({ state: 'started', n, s, ts: Date.now(), epoch: Number(quizData && quizData.lockEpoch) || 0 }));\n524:       } catch (e) { }\n525:       person = { n, s };"}
