ares one expression against a list of constant case labels and runs the matching block.\"],\n116 [\"What is the output when x = 1?\\nswitch (x) {\\n  case 1:\\n  case 2: printf(\\\"Low\\\"); break;\\n  case 3: printf(\\\"High\\\");\\n}\",[\"Low\",\"High\",\"LowHigh\",\"Nothing is printed\"],\"Stacked labels share one block, so case 1 falls into case 2's code, which prints Low and breaks.\"],\n190 rec.code=btoa(unescape(encodeURIComponent(JSON.stringify(rec))));\n191 try{const all=JSON.parse(localStorage.getItem('ds_exam_results')||'[]');all.push(rec);localStorage.setItem('ds_exam_results',JSON.stringify(all))}catch(e){}\n212 a.download='result_'+rec.n.replace(/\\W+/g,'_')+'_'+rec.s.replace(/\\W+/g,'_')+'.json';a.click();\n216 const manual=()=>{if(!$('codebox')){const t=document.createElement('textarea');t.id='codebox';t.readOnly=true;t.value=rec.code;t.style.cssText='width:100%;height:90px;margin-top:10px';$('cp').parentNode.after(t)}$('codebox').select()};\n217 try{navigator.clipboard.writeText(rec.code).then(done).catch(manual)}catch(e){manual()}\n225 a.download='result_'+rec.n.replace(/\\W+/g,'_')+'_'+rec.s.replace(/\\W+/g,'_')+'.json';a.click();\n232 $('lk2').textContent='Your response has been recorded for '+L.rec.n+' ('+L.rec.s+'). Please wait for your instructor to announce the results.';\n"}
