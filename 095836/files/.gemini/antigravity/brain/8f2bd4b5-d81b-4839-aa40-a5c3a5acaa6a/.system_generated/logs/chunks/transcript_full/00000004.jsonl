h() {\r\n  if (!running) return;\r\n  running = false;\r\n  clearInterval(iv);\r\n  let raw = 0;\r\n  items.forEach((it, i) => {\r\n    if (answers[i] != null && it.opts[answers[i]] && it.opts[answers[i]].c) raw++;\r\n  });\r\n  const st = quizData.settings || {};\r\n  const penRate = (st.enableTabViolation !== false && st.tabViolationPenalty != null) ? st.tabViolationPenalty : 1;\r\n  const pen = st.enableTabViolation !== false ? switches * penRate : 0;\r\n  const final = Math.max(0, raw - pen);\r\n  const rec = {\r\n    n: person.n,\r\n    s: person.s,\r\n    raw,\r\n    sw: switches,\r\n    pen,\r\n    sc: final,\r\n    tot: items.length,\r\n    ts: Date.now(),\r\n    t: Math.round((Date.now() - startedAt) / 1000)\r\n  };\r\n  rec.code = btoa(unescape(encodeURIComponent(JSON.stringify(rec))));\r\n  if (db) {\r\n    try {\r\n      db.collection(\"quizzes\").doc(quizId).collection(\"submissions\").add({\r\n        ...rec,\r\n        submittedAt: Date.now()\r\n      });\r\n    } catch (e) {}\r\n  }\r\n  try {\r\n    const all = JSON.parse(localStorage.getItem('ds_exam_results') || '[]');\r\n    all.push(rec);\r\n    localStorage.setItem('ds_exam_results', JSON.stringify(all));\r\n  } catch (e) {}\r\n  try {\r\n    localStorage.setItem(LOCK, JSON.stringify({ state: 'done', rec }));\r\n  } catch (e) {}\r\n  $('exam').classList.add('hide');\r\n  $('res').classList.remove('hide');\r\n  $('rn').textContent = person.n + ' (' + person.s + ')';\r\n  $('rs').textContent = final + ' / ' + items.length;\r\n  $('rd').textContent = 'Correct answers: ' + raw + ' | Tab-switch violations: ' + switches + ' (-' + pen + ' pts)';\r\n  const f = $('fbs');\r\n  f.innerHTML = '';\r\n  items.forEach((it, i) => {\r\n    const a = answers[i], ok = a != null && it.opts[a] && it.opts[a].c;\r\n    const d = document.createElement('div');\r\n    d.className = 'card fb ' + (ok ? 'ok' : 'no');\r\n    const tag = document.createElement('span');\r\n    tag.className = 'tag ' + (ok ? 'ok' : 'no');\r\