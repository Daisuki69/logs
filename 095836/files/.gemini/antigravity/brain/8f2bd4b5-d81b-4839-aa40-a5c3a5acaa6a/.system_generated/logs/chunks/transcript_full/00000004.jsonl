 != null && it.opts[answers[i]] && it.opts[answers[i]].c) raw++;\r\n  });\r\n  const st = quizData.settings || {};\r\n  const penRate = (st.enableTabViolation !== false && st.tabViolationPenalty != null) ? st.tabViolationPenalty : 1;\r\n  const pen = st.enableTabViolation !== false ? switches * penRate : 0;\r\n  const final = Math.max(0, raw - pen);\r\n  const rec = {\r\n    n: person.n,\r\n    s: person.s,\r\n    raw,\r\n    sw: switches,\r\n    pen,\r\n    sc: final,\r\n    tot: items.length,\r\n    ts: Date.now(),\r\n    t: Math.round((Date.now() - startedAt) / 1000)\r\n  };\r\n  rec.code = btoa(unescape(encodeURIComponent(JSON.stringify(rec))));\r\n  if (db) {\r\n    try {\r\n      db.collection(\"quizzes\").doc(quizId).collection(\"submissions\").add({\r\n        ...rec,\r\n        submittedAt: Date.now()\r\n      });\r\n    } catch (e) {}\r\n  }\r\n  try {\r\n    const all = JSON.parse(localStorage.getItem('ds_exam_results') || '[]');\r\n    all.push(rec);\r\n    localStorage.setItem('ds_exam_results', JSON.stringify(all));\r\n  } catch (e) {}\r\n  try {\r\n    localStorage.setItem(LOCK, JSON.stringify({ state: 'done', rec }));\r\n  } catch (e) {}\r\n  $('exam').classList.add('hide');\r\n  $('res').classList.remove('hide');\r\n  $('rn').textContent = person.n + ' (' + person.s + ')';\r\n  $('rs').textContent = final + ' / ' + items.length;\r\n  $('rd').textContent = 'Correct answers: ' + raw + ' | Tab-switch violations: ' + switches + ' (-' + pen + ' pts)';\r\n  const f = $('fbs');\r\n  f.innerHTML = '';\r\n  items.forEach((it, i) => {\r\n    const a = answers[i], ok = a != null && it.opts[a] && it.opts[a].c;\r\n    const d = document.createElement('div');\r\n    d.className = 'card fb ' + (ok ? 'ok' : 'no');\r\n    const tag = document.createElement('span');\r\n    tag.className = 'tag ' + (ok ? 'ok' : 'no');\r\n    tag.textContent = ok ? 'CORRECT' : (a == null ? 'NO ANSWER' : 'WRONG');\r\n    const h = document.createElement('b');\r\n    h.textContent = 'Question ' + (i + 1) + ' ';\r\n    const p = document.createElement('pre');\r\n    p.textContent = it.q;\r\n    const y = document.createElement('div');\r\n    y.textContent = 'Your answer: ' + (a == null ? '(no answer)' : it.opts[a].t.replace(/\\n/g, ' '));\r\n    const corr = it.opts.find(o => o.c);\r\n    const c = document.createElement('div');\r\n    c.textContent = 'Correct answer: ' + (corr ? corr.t.replace(/\\n/g, ' ') : '');\r\n    const e = document.createElement('div');\r\n    e.style.color = 'var(--mu)';\r\n    e.textContent = 'Explanation: ' + it.e;\r\n    d.append(h, tag, p, y, c, e);\r\n    f.appendChild(d);\r\n  });\r\n  $('dl').onclick = () => dlRec(rec);\r\n  $('cp').onclick = () => {\r\n    const done = () => { $('cp').textContent = 'Copied!'; };\r\n    const manual = () => {\r\n      if (!$('codebox')) {\r\n        const t = document.createElement('textarea');\r\n        t.id = 'codebox';\r\n        t.readOnly = true;\r\n        t.value = rec.code;\r\n        t.style.cssText = 'width:100%;height:90px;margin-top:10px';\r\n        $('cp').parentNode.after(t);\r\n      }\r\n      $('codebox').select();\r\n    };\r\n    try {\r\n      navigator.clipboard.writeText(rec.code).then(done).catch(manual);\r\n    } catch (e) {\r\n      manual();\r\n    }\r\n  };\r\n  window.scrollTo(0, 0);\r\n}\r\n\r\nfunction dlRec(rec) {\r\n  const blob = new Blob([JSON.stringify(rec, null, 2)], { type: 'application/json' });\r\n  const a = document.createElement('a');\r\n  a.href = URL.createObjectURL(blob);\r\n  a.download = 'result_' + rec.n.replace(/\\W+/g, '_') + '_' + rec.s.replace(/\\W+/g, '_') + '.json';\r\n  a.click();\r\n}\r\n\r\nfunction showLock() {\r\n  let L = null;\r\n  try { L = JSON.parse(localStorage.getItem(LOCK)); } catch (e) {}\r\n  $('start').classList.add('hide');\r\n  $('exam').classList.add('hide');\r\n  $('res').classList.add('hide');\r\n  $('lock').classList.remove('hide');\r\n  if (L && L.state === 'done') {\r\n    $('lk2').textContent = 'Your response has been recorded for ' + L.rec.n + ' (' + L.rec.s + '). Please wait for your instructor to announce the results.';\r\n    $('lkdl').classList.remove('hide');\r\n    $('lkdl').onclick = () => dlRec(L.rec);\r\n  } else if (L) {\r\n    $('lk2').textContent = 'A quiz session for ' + L.n + ' (' + L.s + ') was already started on this device and cannot be reopened. Please inform your instructor.';\r\n  }\r\n}\r\n\r\nfunction chkReset() {\r\n  try {\r\n    if (location.hash === '#reset-quiz') {\r\n      localStorage.removeItem(LOCK);\r\n      history.replaceState(null, '', location.pathname + location.search);\r\n      location.reload();\r\n    }\r\n  } catch (e) {}\r\n}\r\nwindow.addEventListener('hashchange', chkReset);\r\nchkReset();\r\ntry {\r\n  if (localStorage.getItem(LOCK)) showLock();\r\n} catch (e) {}\r\n</script>\r\n\r\n\r\n</body></html>\r\n"}
