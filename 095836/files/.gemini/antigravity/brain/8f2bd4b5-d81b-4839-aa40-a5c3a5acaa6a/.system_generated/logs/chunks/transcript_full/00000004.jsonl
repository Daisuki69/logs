;font-weight:600}\r\nbutton.sec{background:transparent;color:var(--pr);border:1px solid var(--pr)}\r\n.hide{display:none!important}\r\n.top{display:flex;justify-content:space-between;align-items:center;font-weight:600;margin-bottom:8px}\r\n.bar{height:8px;background:var(--bd);border-radius:6px;overflow:hidden;margin-bottom:16px}\r\n#tb{height:100%;width:100%;background:var(--pr);transition:width .1s linear}\r\n#tb.low{background:var(--bad)}\r\n#q{white-space:pre-wrap;font-size:1.05rem;font-weight:600;margin-bottom:14px;line-height:1.5}\r\n.opt{display:block;width:100%;text-align:left;background:var(--bg);color:var(--tx);border:2px solid var(--bd);margin-bottom:10px;font-weight:500;font-family:ui-monospace,Consolas,monospace;font-size:.95rem;white-space:pre-wrap}\r\n.opt.sel{border-color:var(--pr);background:color-mix(in srgb,var(--pr) 14%,var(--bg))}\r\n.warn{position:fixed;inset:0;background:rgba(0,0,0,.75);display:flex;align-items:center;justify-content:center;z-index:9;padding:20px}\r\n.warn .card{max-width:420px;text-align:center;border:2px solid var(--bad)}\r\n.big{font-size:2.6rem;font-weight:800;color:var(--pr)}\r\n.fb{border-left:5px solid var(--bd)}\r\n.fb.ok{border-left-color:var(--ok)}.fb.no{border-left-color:var(--bad)}\r\n.tag{font-size:.8rem;font-weight:700;padding:2px 8px;border-radius:20px;color:#fff}\r\n.tag.ok{background:var(--ok)}.tag.no{background:var(--bad)}\r\n.fb pre{white-space:pre-wrap;font-family:inherit;margin:8px 0;font-weight:600}\r\n.fb div{margin:4px 0;font-size:.95rem}\r\n.row{display:flex;gap:10px;flex-wrap:wrap}\r\n</style>\r\n</head>\r\n<body>\r\n<div class=\"wrap\">\r\n\r\n<div id=\"start\" class=\"card\">\r\n  <h1 id=\"title\">C Quiz: Switch Case</h1>\r\n  <p id=\"desc\">20 items • 20 seconds per question • Do not switch tabs or windows.</p>\r\n  <label>Full Name<input id=\"nm\" placeholder=\"Juan Dela Cruz\" autocomplete=\"off\"></label>\r\n  <label>Section<input id=\"sc\" placeholder=\"e.g. BSIT 2-A\" autocomplete=\"off\"></lab