ion.';\n406:     $('status-msg').style.color = 'var(--bad)';\n407:     return;\n408:   }\n409: \n410:   $('status-msg').textContent = 'Saving to Firebase...';\n411:   $('status-msg').style.color = 'var(--mu)';\n412:   if (db) {\n413:     db.collection(\"quizzes\").doc(quizId).set({\n414:       title,\n415:       description: desc,\n416:       settings: settingsState,\n417:       questions,\n418:       updatedAt: Date.now()\n419:     }).then(() => {\n420:       $('status-msg').textContent = 'Saved successfully to Firebase! Quiz is live.';\n421:       $('status-msg').style.color = 'var(--ok)';\n422:     }).catch(err => {\n423:       $('status-msg').textContent = 'Error saving: ' + err.message;\n424:       $('status-msg').style.color = 'var(--bad)';\n425:     });\n426:   } else {\n427:     $('status-msg').textContent = 'Firebase is not initialized.';\n428:     $('status-msg').style.color = 'var(--bad)';\n429:   }\n430: };\n431: </script>\n432: </body>\n433: </html>"}
