];\n419:         return {\n420:           q: item.q,\n421:           e: item.explanation || \"\",\n422:           opts: st.randomizeAnswers ? shuffle(choices) : choices\n423:         };\n424:       });\n425:       idx = 0;\n426:       answers = [];\n427:       switches = 0;\n428:       running = true;\n429:       startedAt = Date.now();\n430:       $('start').classList.add('hide');","truncated_fields":["content"]}
