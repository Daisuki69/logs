Please add at least one question.';\n369:     $('status-msg').style.color = 'var(--bad)';\n370:     return;\n371:   }\n372: \n373:   $('status-msg').textContent = 'Saving...';\n374:   $('status-msg').style.color = 'var(--mu)';\n375:   if (db) {\n376:     db.collection(\"quizzes\").doc(quizId).set({\n377:       title,\n378:       description: desc,\n379:       settings: settingsState,\n380:       questions,\n381:       updatedAt: Date.now()\n382:     }).then(() => {\n383:       $('status-msg').textContent = 'Saved Successfully to Student Quiz File! Quiz is live.';\n384:       $('status-msg').style.color = 'var(--ok)';\n385:     }).catch(err => {\n386:       if (err.code === 'permission-denied' || String(err).includes('permission')) {\n387:         $('status-msg').textContent = 'Security rules currently block quiz overwrite (allow write: if false). Use Download Quiz JSON to save a backup.';\n388:       } else {\n389:         $('status-msg').textContent = 'Error saving: ' + err.message;\n390:       }\n391:       $('status-msg').style.color = 'var(--bad)';\n392:     });\n393:   } else {\n394:     $('status-msg').textContent = 'Database is not initialized.';\n395:     $('status-msg').style.color = 'var(--bad)';\n396:   }\n397: };\n398: \n399: $('dl-quiz-btn').onclick = () => {\n400:   const title = $('qtitle').value.trim() || 'quiz';\n401:   const desc = $('qdesc').value.trim();\n402:   const cards = $('questions-container').querySelectorAll('.q-card');\n403:   const questions = [];\n404:   cards.forEach(c => {\n405:     const q = c.querySelector('.q-text').value.trim();\n406:     const correct = c.querySelector('.q-corr').value.trim();\n407:     const w1 = c.querySelector('.q-w1').value.trim();\n408:     const w2 = c.querySelector('.q-w2').value.trim();\n409:     const w3 = c.querySelector('.q-w3').value.trim();\n410:     const exp = c.querySelector('.q-exp').value.trim();\n411:     if (q || correct) {\n412:       questions.push({\n413:         q,\n414:         correct,\n415:         wrongs: [w1, w2, w3].filter(Boolean),\n416:         explanation: exp\n417:       });\n418:     }\n419:   });\n420:   const data = {\n421:     title,\n422:     description: desc,\n423:     settings: {\n424:       ...settingsState,\n425:       tabViolationPenalty: parseInt($('pen-val').value, 10) || 0,\n426:       timePerQuestion: parseInt($('time-val').value, 10) || 20\n427:     },\n428:     questions,\n429:     updatedAt: Date.now()\n430:   };\n431:   const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });\n432:   const a = document.createElement('a');\n433:   a.href = URL.createObjectURL(blob);\n434:   a.download = title.replace(/\\W+/g, '_').toLowerCase() + '.json';\n435:   a.click();\n436: };\n437: </script>\n438: </body>\n439: </html>"}
