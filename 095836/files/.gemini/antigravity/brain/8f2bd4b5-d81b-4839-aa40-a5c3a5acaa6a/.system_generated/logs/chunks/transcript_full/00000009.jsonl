:"import { initializeApp } from \"https://www.gstatic.com/firebasejs/10.14.0/firebase-app.js\";\nimport { getFirestore, doc, getDoc, setDoc, addDoc, collection } from \"https://www.gstatic.com/firebasejs/10.14.0/firebase-firestore.js\";\n\nconst firebaseConfig = {\n  apiKey: \"AIzaSyBkqJ9WvtXfGJt19XK7SLK9v5cJwp4EVII\",\n  authDomain: \"sir-jasper-quiz.firebaseapp.com\",\n  projectId: \"sir-jasper-quiz\",\n  storageBucket: \"sir-jasper-quiz.firebasestorage.app\",\n  messagingSenderId: \"932129654171\",\n  appId: \"1:932129654171:web:793aa17dd1f130a62f4d3e\"\n};\n\nconst app = initializeApp(firebaseConfig);\nconst db = getFirestore(app);\n\nexport async function getActiveQuiz(quizId = \"active\") {\n  try {\n    const snap = await getDoc(doc(db, \"quizzes\", quizId));\n    if (snap.exists()) {\n      return snap.data();\n    }\n  } catch (err) {}\n  return null;\n}\n\nexport async function saveActiveQuiz(quizData, quizId = \"active\") {\n  const ref = doc(db, \"quizzes\", quizId);\n  await setDoc(ref, {\n    ...quizData,\n    updatedAt: Date.now()\n  });\n  return true;\n}\n\nexport async function saveSubmission(resultData, quizId = \"active\") {\n  try {\n    const subCol = collection(db, \"quizzes\", quizId, \"submissions\");\n    await addDoc(subCol, {\n      ...resultData,\n      submittedAt: Date.now()\n    });\n  } catch (err) {}\n}\n\nexport { app, db };\n","Overwrite":true,"Path":"C:\\Users\\CxAdmin\\Desktop\\Exploit\\firebase-config.js"}}]}
