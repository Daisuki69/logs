{"step_index":361,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-08T22:00:57Z","content":"Created At: 2026-11-09T06:00:57+08:00\nCompleted At: 2026-11-09T06:00:58+08:00\nShowing lines 1-50 of 181\n1: import { initializeApp } from \"https://www.gstatic.com/firebasejs/10.14.0/firebase-app.js\";\n2: import { getFirestore, doc, getDoc, setDoc, addDoc, collection } from \"https://www.gstatic.com/firebasejs/10.14.0/firebase-firestore.js\";\n3: \n4: const firebaseConfig = {\n5:   apiKey: \"AIzaSyBkqJ9WvtXfGJt19XK7SLK9v5cJwp4EVII\",\n6:   authDomain: \"sir-jasper-quiz.firebaseapp.com\",\n7:   projectId: \"sir-jasper-quiz\",\n8:   storageBucket: \"sir-jasper-quiz.firebasestorage.app\",\n9:   messagingSenderId: \"932129654171\",\n10:   appId: \"1:932129654171:web:793aa17dd1f130a62f4d3e\"\n11: };\n12: \n13: const app = initializeApp(firebaseConfig);\n14: const db = getFirestore(app);\n15: \n16: export const defaultQuiz = {\n17:   title: \"C Quiz: Switch Case\",\n18:   description: \"20 items • 20 seconds per question • Do not switch tabs or windows.\",\n19:   settings: {\n20:     timePerQuestion: 20,\n21:     enableTimer: true,\n22:     enableTabViolation: true,\n23:     tabViolationPenalty: 1,\n24:     randomizeQuestions: true,\n25:     randomizeAnswers: true\n26:   },\n27:   questions: [\n28:     {\n29:       q: \"Which C statement selects one of many code blocks to run based on the value of an expression?\",\n30:       correct: \"switch\",\n31:       wrongs: [\"for\", \"while\", \"goto\"],\n32:       explanation: \"switch compares one expression against a list of constant case labels and runs the matching block.\"\n33:     },\n34:     {\n35:       q: \"Which type of expression can be used as the controlling expression of a switch in C?\",\n36:       correct: \"int or char\",\n37:       wrongs: [\"float\", \"double\", \"string (char*)\"],\n38:       explanation: \"switch works with integral types such as int and char, not floating-point values or strings.\"\n39:     },\n40:     {\n41:       q: \"Which keyword prevents execution from falling through to the next case?\",\n42:       correct: \"break\",\n43:       wrongs: [\"continue\", \"return 0\", \"exit\"],\n44:       explanation: \"break leaves the switch block immediately after the matching case finishes.\"\n45:     },\n46:     {\n47:       q: \"When does the default label run?\",\n48:       correct: \"When no case label matches\",\n49:       wrongs: [\"Always, before the cases\", \"Only when the first case fails\", \"Only if break is missing\"],\n50:       explanation: \"default is the fallback block used when no case matches the expression.\""}
