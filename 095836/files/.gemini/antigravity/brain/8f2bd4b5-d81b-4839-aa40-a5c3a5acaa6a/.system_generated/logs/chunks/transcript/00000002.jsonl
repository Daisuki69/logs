;font-weight:600}\r\nbutton.sec{background:transparent;color:var(--pr);border:1px solid var(--pr)}\r\n.hide{display:none!important}\r\n.top{display:flex;justify-content:space-between;align-items:center;font-weight:600;margi\n<truncated 6221 bytes>\ncp').onclick = () => {\r\n    const done = () => { $('cp').textContent = 'Copied!'; };\r\n    const manual = () => {\r\n      if (!$('codebox')) {\r\n        const t = document.createElement('textarea');\r\n        t.id = 'codebox';\r\n        t.readOnly = true;\r\n        t.value = rec.code;\r\n        t.style.cssText = 'width:100%;height:90px;margin-top:10px';\r\n        $('cp').parentNode.after(t);\r\n      }\r\n      $('codebox').select();\r\n    };\r\n    try {\r\n      navigator.clipboard.writeText(rec.code).then(done).catch(manual);\r\n    } catch (e) {\r\n      manual();\r\n    }\r\n  };\r\n  window.scrollTo(0, 0);\r\n}\r\n\r\nfunction dlRec(rec) {\r\n  const blob = new Blob([JSON.stringify(rec, null, 2)], { type: 'application/json' });\r\n  const a = document.createElement('a');\r\n  a.href = URL.createObjectURL(blob);\r\n  a.download = 'result_' + rec.n.replace(/\\W+/g, '_') + '_' + rec.s.replace(/\\W+/g, '_') + '.json';\r\n  a.click();\r\n}\r\n\r\nfunction showLock() {\r\n  let L = null;\r\n  try { L = JSON.parse(localStorage.getItem(LOCK)); } catch (e) {}\r\n  $('start').classList.add('hide');\r\n  $('exam').classList.add('hide');\r\n  $('res').classList.add('hide');\r\n  $('lock').classList.remove('hide');\r\n  if (L && L.state === 'done') {\r\n    $('lk2').textContent = 'Your response has been recorded for ' + L.rec.n + ' (' + L.rec.s + '). Please wait for your instructor to announce the results.';\r\n    $('lkdl').classList.remove('hide');\r\n    $('lkdl').onclick = () => dlRec(L.rec);\r\n  } else if (L) {\r\n    $('lk2').textContent = 'A quiz session for ' + L.n + ' (' + L.s + ') was already started on this device and cannot be reopened. Please inform your instructor.';\r\n  }\r\n}\r\n\r\nfunction chkReset() {\r\n  try {\r\n    if (location.hash === '#reset-quiz') {\r\n      localStorage.removeItem(LOCK);\r\n      history.replaceState(null, '', location.pathname + location.search);\r\n      location.reload();\r\n    }\r\n  } catch (e) {}\r\n}\r\nwindow.addEventListener('hashchange', chkReset);\r\nchkReset();\r\ntry {\r\n  if (localStorage.getItem(LOCK)) showLock();\r\n} catch (e) {}\r\n</script>\r\n\r\n\r\n</body></html>\r\n","truncated_fields":["content"]}
