   if (L && L.state === 'done') {\n759:         $('lk2').textContent = 'Your response has been recorded for ' + L.rec.n + ' (' + L.rec.s + '). Please wait for your instructor to announce the results.';\n760:         const isAuto = !quizData || !quizData.settings || quizData.settings.autoRecordQuiz !== false;\n761:         if (!isAuto) {\n762:           $('lkdl').classList.remove('hide');\n763:           $('lkdl').onclick = () => dlRec(L.rec);\n764:         } else {\n765:           $('lkdl').classList.add('hide');\n766:         }\n767:       } else if (L) {\n768:         $('lk2').textContent = 'A quiz session for ' + L.n + ' (' + L.s + ') was already started on this device and cannot be reopened. Please inform your instructor.';\n769:       }\n770:     }\n771: \n772:     function chkReset() {\n773:       try {\n774:         if (location.hash === '#reset-quiz') {\n775:           localStorage.removeItem(LOCK);\n776:           history.replaceState(null, '', location.pathname + location.search);\n777:           location.reload();\n778:         }\n779:       } catch (e) { }\n780:     }\n781:     window.addEventListener('hashchange', chkReset);\n782:     chkReset();\n783:     try {\n784:       if (localStorage.getItem(LOCK)) showLock();\n785:     } catch (e) { }\n786:     document.addEventListener('contextmenu', e => {\n787:       if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA') e.preventDefault();\n788:     });\n789:     document.addEventListener('selectstart', e => {\n790:       if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA') e.preventDefault();\n791:     });\n792:     document.addEventListener('copy', e => {\n793:       if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA') e.preventDefault();\n794:     });\n795:     document.addEventListener('keydown', e => {\n796:       const k = e.key.toLowerCase();\n797:       if ((e.ctrlKey || e.metaKey) && (k === 'a' || k === 'c')) {\n798:         if (e.target.tagName !== 'INP