im();\r\n    const exp = c.querySelector('.q-exp').value.trim();\r\n    if (q || correct) {\r\n      questions.push({\r\n        q,\r\n        correct,\r\n        wrongs: [w1, w2, w3].filter(Boolean),\r\n        explanation: exp\r\n      });\r\n    }\r\n  });\r\n  const data = {\r\n    title,\r\n    description: desc,\r\n    settings: {\r\n      ...settingsState,\r\n      tabViolationPenalty: parseInt($('pen-val').value, 10) || 0,\r\n      timePerQuestion: parseInt($('time-val').value, 10) || 20\r\n    },\r\n    questions,\r\n    updatedAt: Date.now()\r\n  };\r\n  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });\r\n  const a = document.createElement('a');\r\n  a.href = URL.createObjectURL(blob);\r\n  a.download = title.replace(/\\W+/g, '_').toLowerCase() + '.json';\r\n  a.click();\r\n};\r\n</script>\r\n\r\n\r\n</body></html>\r\n"}
