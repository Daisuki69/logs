{"step_index":382,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-08T21:55:42Z","content":"Created At: 2026-11-09T05:55:42+08:00\nCompleted At: 2026-11-09T05:55:42+08:00\nShowing lines 1-181 of 181\n1: import { initializeApp } from \"https://www.gstatic.com/firebasejs/10.14.0/firebase-app.js\";\n2: import { getFirestore, doc, getDoc, setDoc, addDoc, collection } from \"https://www.gstatic.com/firebasejs/10.14.0/firebase-firestore.js\";\n3: \n4: const firebaseConfig = {\n5:   apiKey: \"AIzaSyBkqJ9WvtXfGJt19XK7SLK9v5cJwp4EVII\",\n6:   authDomain: \"sir-jasper-quiz.firebaseapp.com\",\n7:   projectId: \"sir-jasper-quiz\",\n8:   storageBucket: \"sir-jasper-quiz.firebasestorage.app\",\n9:   messagingSenderId: \"932129654171\",\n10:   appId: \"1:932129654171:web:793aa17dd1f130a62f4d3e\"\n11: };\n12: \n13: const app = initializeApp(firebaseConfig);\n14: const db = getFirestore(app);\n15: \n16: export const defaultQuiz = {\n17:   title: \"C Quiz: Switch Case\",\n18:   description: \"20 items • 20 seconds per question • Do not switch tabs or windows.\",\n19:   settings: {\n20:     timePerQuestion: 20,\n21:     enableTimer: true,\n22:     enableTabViolation: true,\n23:     tabViolationPenalty: 1,\n24:     randomizeQuestions: true,\n25:     randomizeAnswers: true\n26:   },\n27:   questions: [\n28:     {\n29:       q: \"Which C statement selects one of many code blocks to run based on the value of an expression?\",\n30:       correct: \"switch\",\n31:       wrongs: [\"for\", \"while\", \"goto\"],\n32:       explanation: \"switch compares one expression against a list of constant case labels and runs the matching block.\"\n33:     },\n34:     {\n35:       q: \"Which type of expression can be used as the controlling expression of a switch in C?\",\n36:       correct: \"int or char\",\n37:       wrongs: [\"float\", \"double\", \"string (char*)\"],\n38:       explanation: \"switch works with integral types such as int and char, not floating-point values or strings.\"\n39:     },\n40:     {\n41:       q: \"Which keyword prevents execution from falling through to the next case?\",\n42:       correct: \"break\",\n43:       wrongs: [\"continue\", \"return 0\", \"exit\"],\n44:       explanation: \"break leaves the switch block immediately after the matching case finishes.\"\n45:     },\n46:     {\n47:       q: \"When does the default label run?\",\n48:       correct: \"When no case label matches\",\n49:       wrongs: [\"Always, before the cases\", \"Only when the first case fails\", \"Only if break is missing\"],\n50:       explanation: \"default is the fallback block used when no case matches the expression.\"\n51:     },\n52:     {\n53:       q: \"What is the output?\\nint x = 2;\\nswitch (x) {\\n  case 1: printf(\\\"A\\\");\\n  case 2: printf(\\\"B\\\");\\n  case 3: printf(\\\"C\\\");\\n}\",\n54:       correct: \"BC\",\n55:       wrongs: [\"B\", \"C\", \"ABC\"],\n56:       explanation: \"No break statements, so execution starts at case 2 and falls through to case 3.\"\n57:     },\n58:     {\n59:       q: \"What is the output?\\nint x = 3;\\nswitch (x) {\\n  case 1: printf(\\\"1\\\"); break;\\n  default: printf(\\\"D\\\");\\n}\",\n60:       correct: \"D\",\n61:       wrongs: [\"1\", \"1D\", \"Nothing is printed\"],\n62:       explanation: \"x is 3, no case matches, so default runs.\"\n63:     },\n64:     {\n65:       q: \"Is the default label required in a switch statement?\",\n66:       correct: \"No, it is optional\",\n67:       wrongs: [\"Yes, always\", \"Yes, but only with char\", \"Only if there is no break\"],\n68:       explanation: \"default is optional; without it, nothing runs when no case matches.\"\n69:     },\n70:     {\n71:       q: \"Which case label is valid in C?\",\n72:       correct: \"case 'A':\",\n73:       wrongs: [\"case x:  (x is a variable)\", \"case 1.5:\", \"case \\\"A\\\":\"],\n74:       explanation: \"Case labels must be integer or character constants. Variables, floats and strings are not allowed.\"\n75:     },\n76:     {\n77:       q: \"What is the output?\\nchar c = 'b';\\nswitch (c) {\\n  case 'a': printf(\\\"1\\\"); break;\\n  case 'b': printf(\\\"2\\\");\\n  case 'c': printf(\\\"3\\\"); break;\\n}\",\n78:       correct: \"23\",\n79:       wrongs: [\"2\", \"3\", \"123\"],\n80:       explanation: \"case 'b' matches and prints 2, has no break, then falls into case 'c' and prints 3 before break.\"\n81:     },\n82:     {\n83:       q: \"What happens if two case labels in the same switch have the same constant value?\",\n84:       correct: \"Compile-time error\",\n85:       wrongs: [\"The first one runs\", \"The last one runs\", \"Both run\"],\n86:       explanation: \"Duplicate case values are not allowed and the compiler reports an error.\"\n87:     },\n88:     {\n89:       q: \"Where can the default label be placed inside a switch?\",\n90:       correct: \"Anywhere inside the switch\",\n91:       wrongs: [\"Only at the end\", \"Only at the beginning\", \"Only after a break\"],\n92:       explanation: \"default may appear in any position; it is used only when no case matches.\"\n93:     },\n94:     {\n95:       q: \"What is the output when x = 1?\\nswitch (x) {\\n  case 1:\\n  case 2: printf(\\\"Low\\\"); break;\\n  case 3: printf(\\\"High\\\");\\n}\",\n96:       correct: \"Low\",\n97:       wrongs: [\"High\", \"LowHigh\", \"Nothing is printed\"],\n98:       explanation: \"Stacked labels share one block, so case 1 falls into case 2's code, which prints Low and breaks.\"\n99:     },\n100:     {\n101:       q: \"Which is NOT allowed as the controlling expression of a switch in C?\",\n102:       correct: \"A float variable, e.g. switch(f)\",\n103:       wrongs: [\"An int variable, e.g. switch(x)\", \"A char variable, e.g. switch(c)\", \"An expression, e.g. switch(x % 3)\"],\n104:       explanation: \"The controlling expression must be an integer type; float values are not allowed.\"\n105:     },\n106:     {\n107:       q: \"Which statement about case labels is true?\",\n108:       correct: \"They must be constant expressions\",\n109:       wrongs: [\"They can be any variable\", \"They can be float values\", \"They can be strings\"],\n110:       explanation: \"The compiler needs constant integer or character values to build the jump table.\"\n111:     },\n112:     {\n113:       q: \"What is the output?\\nint x = 5;\\nswitch (x % 2) {\\n  case 0: printf(\\\"Even\\\"); break;\\n  case 1: printf(\\\"Odd\\\"); break;\\n}\",\n114:       correct: \"Odd\",\n115:       wrongs: [\"Even\", \"EvenOdd\", \"Nothing is printed\"],\n116:       explanation: \"5 % 2 is 1, so case 1 runs.\"\n117:     },\n118:     {\n119:       q: \"What is the output?\\nint x = 1;\\nswitch (x) {\\n  default: printf(\\\"D\\\");\\n  case 1: printf(\\\"1\\\"); break;\\n  case 2: printf(\\\"2\\\");\\n}\",\n120:       correct: \"1\",\n121:       wrongs: [\"D1\", \"D\", \"12\"],\n122:       explanation: \"x matches case 1 directly, so default is skipped. Only 1 is printed, then break.\"\n123:     },\n124:     {\n125:       q: \"When is switch preferred over an if-else if chain?\",\n126:       correct: \"Comparing one variable against several constant values\",\n127:       wrongs: [\"Testing ranges like x > 10\", \"Comparing strings\", \"Evaluating floating-point conditions\"],\n128:       explanation: \"switch is designed for equality checks of one integral value against constants. It cannot test ranges.\"\n129:     },\n130:     {\n131:       q: \"What is the value printed?\\nint a = 1;\\nswitch (a) {\\n  case 1: a++;\\n  case 2: a += 2; break;\\n  case 3: a = 10;\\n}\\nprintf(\\\"%d\\\", a);\",\n132:       correct: \"4\",\n133:       wrongs: [\"3\", \"2\", \"10\"],\n134:       explanation: \"case 1 makes a = 2, falls into case 2 so a = 4, then break.\"\n135:     },\n136:     {\n137:       q: \"Which is the correct switch syntax?\",\n138:       correct: \"switch (x) { case 1: printf(\\\"One\\\"); break; }\",\n139:       wrongs: [\"switch x { case 1: printf(\\\"One\\\"); break; }\", \"switch (x) { case 1 printf(\\\"One\\\"); break; }\", \"switch (x) { case(1) = printf(\\\"One\\\"); }\"],\n140:       explanation: \"The expression goes in parentheses and each case label ends with a colon.\"\n141:     },\n142:     {\n143:       q: \"Can a switch statement be nested inside another switch statement in C?\",\n144:       correct: \"Yes\",\n145:       wrongs: [\"No\", \"Only inside default\", \"Only with goto\"],\n146:       explanation: \"Switch statements can be nested; each break only exits the innermost switch.\"\n147:     }\n148:   ]\n149: };\n150: \n151: export async function getActiveQuiz(quizId = \"active\") {\n152:   try {\n153:     const snap = await getDoc(doc(db, \"quizzes\", quizId));\n154:     if (snap.exists()) {\n155:       return snap.data();\n156:     }\n157:   } catch (err) {}\n158:   return defaultQuiz;\n159: }\n160: \n161: export async function saveActiveQuiz(quizData, quizId = \"active\") {\n162:   const ref = doc(db, \"quizzes\", quizId);\n163:   await setDoc(ref, {\n164:     ...quizData,\n165:     updatedAt: Date.now()\n166:   });\n167:   return true;\n168: }\n169: \n170: export async function saveSubmission(resultData, quizId = \"active\") {\n171:   try {\n172:     const subCol = collection(db, \"quizzes\", quizId, \"submissions\");\n173:     await addDoc(subCol, {\n174:       ...resultData,\n175:       submittedAt: Date.now()\n176:     });\n177:   } catch (err) {}\n178: }\n179: \n180: export { app, db };\n181: "}
