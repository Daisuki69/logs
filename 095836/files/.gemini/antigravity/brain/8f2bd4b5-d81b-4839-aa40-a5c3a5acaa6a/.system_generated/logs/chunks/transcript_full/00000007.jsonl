count);\r\n  container.appendChild(newCard);\r\n  newCard.scrollIntoView({ behavior: 'smooth' });\r\n};\r\n\r\nfunction populateQuizData(quiz) {\r\n  $('qtitle').value = quiz.title || '';\r\n  $('qdesc').value = quiz.description || '';\r\n  if (quiz.settings) {\r\n    settingsState = { ...settingsState, ...quiz.settings };\r\n  }\r\n  syncOptionsUI();\r\n  const container = $('questions-container');\r\n  container.innerHTML = '';\r\n  (quiz.questions || []).forEach((q, idx) => {\r\n    container.appendChild(createQuestionCard(q, idx + 1));\r\n  });\r\n  if ((quiz.questions || []).length === 0) {\r\n    container.appendChild(createQuestionCard({}, 1));\r\n  }\r\n}\r\n\r\nfunction loadTeacherQuiz() {\r\n  populateQuizData(defaultQuiz);\r\n  if (db) {\r\n    db.collection(\"quizzes\").doc(quizId).get().then(doc => {\r\n      if (doc.exists) {\r\n        populateQuizData(doc.data());\r\n        $('status-msg').textContent = 'Loaded active quiz Locally.';\r\n        $('status-msg').style.color = 'var(--ok)';\r\n      }\r\n    }).catch(() => {});\r\n  }\r\n}\r\nloadTeacherQuiz();\r\n\r\n$('save-btn').onclick = () => {\r\n  const title = $('qtitle').value.trim();\r\n  const desc = $('qdesc').value.trim();\r\n  if (!title) {\r\n    $('status-msg').textContent = 'Please enter a quiz title.';\r\n    $('status-msg').style.color = 'var(--bad)';\r\n    return;\r\n  }\r\n  settingsState.tabViolationPenalty = parseInt($('pen-val').value, 10) || 0;\r\n  settingsState.timePerQuestion = parseInt($('time-val').value, 10) || 20;\r\n\r\n  const cards = $('questions-container').querySelectorAll('.q-card');\r\n  const questions = [];\r\n  cards.forEach(c => {\r\n    const q = c.querySelector('.q-text').value.trim();\r\n    const correct = c.querySelector('.q-corr').value.trim();\r\n    const w1 = c.querySelector('.q-w1').value.trim();\r\n    const w2 = c.querySelector('.q-w2').value.trim();\r\n    const w3 = c.querySelector('.q-w3').value.trim();\r\n    const exp = c.querySelector('.q-exp