n    tag.textContent = ok ? 'CORRECT' : (a == null ? 'NO ANSWER' : 'WRONG');\r\n    const h = document.createElement('b');\r\n    h.textContent = 'Question ' + (i + 1) + ' ';\r\n    const p = document.createElement('pre');\r\n    p.textContent = it.q;\r\n    const y = document.createElement('div');\r\n    y.textContent = 'Your answer: ' + (a == null ? '(no answer)' : it.opts[a].t.replace(/\\n/g, ' '));\r\n    const corr = it.opts.find(o => o.c);\r\n    const c = document.createElement('div');\r\n    c.textContent = 'Correct answer: ' + (corr ? corr.t.replace(/\\n/g, ' ') : '');\r\n    const e = document.createElement('div');\r\n    e.style.color = 'var(--mu)';\r\n    e.textContent = 'Explanation: ' + it.e;\r\n    d.append(h, tag, p, y, c, e);\r\n    f.appendChild(d);\r\n  });\r\n  $('dl').onclick = () => dlRec(rec);\r\n  $('cp').onclick = () => {\r\n    const done = () => { $('cp').textContent = 'Copied!'; };\r\n    const manual = () => {\r\n      if (!$('codebox')) {\r\n        const t = document.createElement('textarea');\r\n        t.id = 'codebox';\r\n        t.readOnly = true;\r\n        t.value = rec.code;\r\n        t.style.cssText = 'width:100%;height:90px;margin-top:10px';\r\n        $('cp').parentNode.after(t);\r\n      }\r\n      $('codebox').select();\r\n    };\r\n    try {\r\n      navigator.clipboard.writeText(rec.code).then(done).catch(manual);\r\n    } catch (e) {\r\n      manual();\r\n    }\r\n  };\r\n  window.scrollTo(0, 0);\r\n}\r\n\r\nfunction dlRec(rec) {\r\n  const blob = new Blob([JSON.stringify(rec, null, 2)], { type: 'application/json' });\r\n  const a = document.createElement('a');\r\n  a.href = URL.createObjectURL(blob);\r\n  a.download = 'result_' + rec.n.replace(/\\W+/g, '_') + '_' + rec.s.replace(/\\W+/g, '_') + '.json';\r\n  a.click();\r\n}\r\n\r\nfunction showLock() {\r\n  let L = null;\r\n  try { L = JSON.parse(localStorage.getItem(LOCK)); } catch (e) {}\r\n  $('start').classList.add('hide');\r\n  $('exam').classList.add('hide');\r\n