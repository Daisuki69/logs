{"step_index":116,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-08T21:05:29Z","input_tokens":7332,"cache_read_tokens":92246,"output_tokens":6886,"tool_calls":[{"name":"write_file","args":{"Content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Teacher Quiz Editor</title>\n<style>\n:root{--bg:#f4f6fb;--card:#fff;--tx:#1b2333;--mu:#5d6779;--pr:#2f5bea;--ok:#12a150;--bad:#d93036;--bd:#dde2ee}\n@media(prefers-color-scheme:dark){:root{--bg:#10141f;--card:#1a2030;--tx:#e8ecf6;--mu:#9aa5bb;--pr:#6f93ff;--ok:#39c47a;--bad:#ff6b70;--bd:#2c354b}}\n*{box-sizing:border-box}\nbody{margin:0;font-family:system-ui,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--tx);padding:16px}\n.wrap{max-width:760px;margin:0 auto}\n.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:20px;margin-bottom:14px}\nh1{font-size:1.4rem;margin:0 0 6px}h2{font-size:1.1rem;margin:0 0 10px}\np,li{color:var(--mu);line-height:1.5}\ninput,textarea{width:100%;padding:12px;margin:6px 0 14px;border:1px solid var(--bd);border-radius:10px;font-size:1rem;background:var(--bg);color:var(--tx);font-family:inherit}\nbutton{font-size:1rem;padding:12px 20px;border:0;border-radius:10px;background:var(--pr);color:#fff;cursor:pointer;font-weight:600}\nbutton.sec{background:transparent;color:var(--pr);border:1px solid var(--pr)}\nbutton.danger{background:transparent;color:var(--bad);border:1px solid var(--bad)}\n.hide{display:none!important}\n.top{display:flex;justify-content:space-between;align-items:center;font-weight:600;margin-bottom:8px}\n.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}\n.opt-toggle{display:flex;justify-content:space-between;align-items:center;padding:12px;background:var(--bg);border:1px solid var(--bd);border-radius:10px;margin-bottom:10px}\n.badge{font-size:0.8rem;padding:3px 8px;border-radius:12px;background:var(--bd);color:var(--tx);font-weight:700}\n.badge.on{background:var(--ok);color:#fff}\n.badge.off{background:var(--mu);color:#fff}\n.q-card{border-left:4px solid var(--pr)}\n.correct-box{border-color:var(--ok)!important}\n.wrong-box{border-color:var(--bd)}\n.floating-add{position:sticky;bottom:16px;display:flex;justify-content:center;z-index:5}\n.plus-btn{border-radius:30px;padding:14px 28px;box-shadow:0 4px 14px rgba(0,0,0,0.15);font-size:1.1rem;display:flex;align-items:center;gap:8px}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n\n<div class=\"card\">\n  <div class=\"top\">\n    <h1>Teacher Quiz Manager</h1>\n    <a href=\"index.html\" target=\"_blank\" style=\"text-decoration:none\"><button class=\"sec\" type=\"button\" style=\"padding:6px 14px;font-size:0.9rem\">Open Student Quiz</button></a>\n  </div>\n  <p>Create, customize, and publish your quiz directly to Firebase Firestore.</p>\n  \n  <label>Quiz Title\n    <input id=\"qtitle\" placeholder=\"e.g. C Programming: Switch Case Quiz\">\n  </label>\n  <label>Quiz Description\n    <input id=\"qdesc\" placeholder=\"e.g. 20 items • 20 seconds per question • Anti-cheat active\">\n  </label>\n  \n  <div class=\"row\" style=\"margin-top:10px\">\n    <button id=\"opt-btn\" class=\"sec\" type=\"button\">Options</button>\n    <button id=\"save-btn\" type=\"button\">Save to Firebase</button>\n    <button id=\"load-def-btn\" class=\"sec\" type=\"button\">Load Default C Quiz</button>\n  </div>\n  <p id=\"status-msg\" style=\"margin:12px 0 0;font-weight:600\"></p>\n</div>\n\n<div id=\"options-panel\" class=\"card hide\">\n  <h2>Quiz Options & Anti-Cheat Rules</h2>\n  \n  <div class=\"opt-toggle\">\n    <div>\n      <b>Auto Randomize Questions</b>\n      <div style=\"font-size:0.85rem;color:var(--mu)\">Shuffle question sequence for every student</div>\n    </div>\n    <button id=\"btn-rand-q\" class=\"sec\" style=\"padding:6px 14px;font-size:0.9rem\">ON</button>\n  </div>\n\n  <div class=\"opt-toggle\">\n    <div>\n      <b>Auto Randomize Answers</b>\n      <div style=\"font-size:0.85rem;color:var(--mu)\">Shuffle A, B, C, D choices per question</div>\n    </div>\n    <button id=\"btn-rand-a\" class=\"sec\" style=\"padding:6px 14px;font-size:0.9rem\">ON</button>\n  </div>\n\n  <div class=\"opt-toggle\">\n    <div>\n      <b>Switching Tab Violation</b>\n      <div style=\"font-size:0.85rem;color:var(--mu)\">Deduct points when tab or window loses focus</div>\n    </div>\n    <button id=\"btn-tab-v\" class=\"sec\" style=\"padding:6px 14px;font-size:0.9rem\">ON</button>\n  </div>\n\n  <div id=\"pen-box\" style=\"margin-left:14px;margin-bottom:12px\">\n    <label style=\"font-size:0.9rem\">Points Deducted per Violation\n      <input id=\"pen-val\" type=\"number\" min=\"0\" max=\"100\" value=\"1\" style=\"max-width:140px;margin-bottom:6px\">\n    </label>\n  </div>\n\n  <div class=\"opt-toggle\">\n    <div>\n      <b>Timer per Question</b>\n      <div style=\"font-size:0.85rem;color:var(--mu)\">Force automatic progression when time expires</div>\n    </div>\n    <button id=\"btn-timer\" class=\"sec\" style=\"padding:6px 14px;font-size:0.9rem\">ON</button>\n  </div>\n\n  <div id=\"time-box\" style=\"margin-left:14px;margin-bottom:12px\">\n    <label style=\"font-size:0.9rem\">Seconds per Question\n      <input id=\"time-val\" type=\"number\" min=\"5\" max=\"3600\" value=\"20\" style=\"max-width:140px;margin-bottom:6px\">\n    </label>\n  </div>\n\n  <div style=\"text-align:right\">\n    <button id=\"close-opt-btn\" class=\"sec\" type=\"button\">Close Options</button>\n  </div>\n</div>\n\n<div id=\"questions-container\"></div>\n\n<div class=\"floating-add\">\n  <button id=\"add-q-btn\" class=\"plus-btn\" type=\"button\">+ Add Question</button>\n</div>\n\n</div>\n\n<script src=\"https://www.gstatic.com/firebasejs/10.14.0/firebase-app-compat.js\"></script>\n<script src=\"https://www.gstatic.com/firebasejs/10.14.0/firebase-firestore-compat.js\"></script>\n<script>\nconst firebaseConfig = {\n  apiKey: \"AIzaSyBkqJ9WvtXfGJt19XK7SLK9v5cJwp4EVII\",\n  authDomain: \"sir-jasper-quiz.firebaseapp.com\",\n  projectId: \"sir-jasper-quiz\",\n  storageBucket: \"sir-jasper-quiz.firebasestorage.app\",\n  messagingSenderId: \"932129654171\",\n  appId: \"1:932129654171:web:793aa17dd1f130a62f4d3e\"\n};\n\nconst defaultQuiz = {\n  title: \"C Quiz: Switch Case\",\n  description: \"20 items • 20 seconds per question • Do not switch tabs or windows.\",\n  settings: {\n    timePerQuestion: 20,\n    enableTimer: true,\n    enableTabViolation: true,\n    tabViolationPenalty: 1,\n    randomizeQuestions: true,\n    randomizeAnswers: true\n  },\n  questions: [\n    { q: \"Which C statement selects one of many code blocks to run based on the value of an expression?\", correct: \"switch\", wrongs: [\"for\", \"while\", \"goto\"], explanation: \"switch compares one expression against a list of constant case labels and runs the matching block.\" },\n    { q: \"Which type of expression can be used as the controlling expression of a switch in C?\", correct: \"int or char\", wrongs: [\"float\", \"double\", \"string (char*)\"], explanation: \"switch works with integral types such as int and char, not floating-point values or strings.\" },\n    { q: \"Which keyword prevents execution from falling through to the next case?\", correct: \"break\", wrongs: [\"continue\", \"return 0\", \"exit\"], explanation: \"break leaves the switch block immediately after the matching case finishes.\" },\n    { q: \"When does the default label run?\", correct: \"When no case label matches\", wrongs: [\"Always, before the cases\", \"Only when the first case fails\", \"Only if break is missing\"], explanation: \"default is the fallback block used when no case matches the expression.\" },\n    { q: \"What is the output?\\nint x = 2;\\nswitch (x) {\\n  case 1: printf(\\\"A\\\");\\n  case 2: printf(\\\"B\\\");\\n  case 3: printf(\\\"C\\\");\\n}\", correct: \"BC\", wrongs: [\"B\", \"C\", \"ABC\"], explanation: \"No break statements, so execution starts at case 2 and falls through to case 3.\" },\n    { q: \"What is the output?\\nint x = 3;\\nswitch (x) {\\n  case 1: printf(\\\"1\\\"); break;\\n  default: printf(\\\"D\\\");\\n}\", correct: \"D\", wrongs: [\"1\", \"1D\", \"Nothing is printed\"], explanation: \"x is 3, no case matches, so default runs.\" },\n    { q: \"Is the default label required in a switch statement?\", correct: \"No, it is optional\", wrongs: [\"Yes, always\", \"Yes, but only with char\", \"Only if there is no break\"], explanation: \"default is optional; without it, nothing runs when no case matches.\" },\n    { q: \"Which case label is valid in C?\", correct: \"case 'A':\", wrongs: [\"case x:  (x is a variable)\", \"case 1.5:\", \"case \\\"A\\\":\"], explanation: \"Case labels must be integer or character constants. Variables, floats and strings are not allowed.\" },\n    { q: \"What is the output?\\nchar c = 'b';\\nswitch (c) {\\n  case 'a': printf(\\\"1\\\"); break;\\n  case 'b': printf(\\\"2\\\");\\n  case 'c': printf(\\\"3\\\"); break;\\n}\", correct: \"23\", wrongs: [\"2\", \"3\", \"123\"], explanation: \"case 'b' matches and prints 2, has no break, then falls into case 'c' and prints 3 before break.\" },\n    { q: \"What happens if two case labels in the same switch have the same constant value?\", correct: \"Compile-time error\", wrongs: [\"The first one runs\", \"The last one runs\", \"Both run\"], explanation: \"Duplicate case values are not allowed and the compiler reports an error.\" },\n    { q: \"Where can the default label be placed inside a switch?\", correct: \"Anywhere inside the switch\", wrongs: [\"Only at the end\", \"Only at the beginning\", \"Only after a break\"], explanation: \"default may appear in any position; it is used only when no case matches.\" },\n    { q: \"What is the output when x = 1?\\nswitch (x) {\\n  case 1:\\n  case 2: printf(\\\"Low\\\"); break;\\n  case 3: printf(\\\"High\\\");\\n}\", correct: \"Low\", wrongs: [\"High\", \"LowHigh\", \"Nothing is printed\"], explanation: \"Stacked labels share one block, so case 1 falls into case 2's code, which prints Low and breaks.\" },\n    { q: \"Which is NOT allowed as the controlling expression of a switch in C?\", correct: \"A float variable, e.g. switch(f)\", wrongs: [\"An int variable, e.g. switch(x)\", \"A char variable, e.g. switch(c)\", \"An expression, e.g. switch(x % 3)\"], explanation: \"The controlling expression must be an integer type; float values are not allowed.\" },\n    { q: \"Which statement about case labels is true?\", correct: \"They must be constant expressions\", wrongs: [\"They can be any variable\", \"They can be float values\", \"They can be strings\"], explanation: \"The compiler needs constant integer or character values to build the jump table.\" },\n    { q: \"What is the output?\\nint x = 5;\\nswitch (x % 2) {\\n  case 0: printf(\\\"Even\\\"); break;\\n  case 1: printf(\\\"Odd\\\"); break;\\n}\", correct: \"Odd\", wrongs: [\"Even\", \"EvenOdd\", \"Nothing is printed\"], explanation: \"5 % 2 is 1, so case 1 runs.\" },\n    { q: \"What is the output?\\nint x = 1;\\nswitch (x) {\\n  default: printf(\\\"D\\\");\\n  case 1: printf(\\\"1\\\"); break;\\n  case 2: printf(\\\"2\\\");\\n}\", correct: \"1\", wrongs: [\"D1\", \"D\", \"12\"], explanation: \"x matches case 1 directly, so default is skipped. Only 1 is printed, then break.\" },\n    { q: \"When is switch preferred over an if-else if chain?\", correct: \"Comparing one variable against several constant values\", wrongs: [\"Testing ranges like x > 10\", \"Comparing strings\", \"Evaluating floating-point conditions\"], explanation: \"switch is designed for equality checks of one integral value against constants. It cannot test ranges.\" },\n    { q: \"What is the value printed?\\nint a = 1;\\nswitch (a) {\\n  case 1: a++;\\n  case 2: a += 2; break;\\n  case 3: a = 10;\\n}\\nprintf(\\\"%d\\\", a);\", correct: \"4\", wrongs: [\"3\", \"2\", \"10\"], explanation: \"case 1 makes a = 2, falls into case 2 so a = 4, then break.\" },\n    { q: \"Which is the correct switch syntax?\", correct: \"switch (x) { case 1: printf(\\\"One\\\"); break; }\", wrongs: [\"switch x { case 1: printf(\\\"One\\\"); break; }\", \"switch (x) { case 1 printf(\\\"One\\\"); break; }\", \"switch (x) { case(1) = printf(\\\"One\\\"); }\"], explanation: \"The expression goes in parentheses and each case label ends with a colon.\" },\n    { q: \"Can a switch statement be nested inside another switch statement in C?\", correct: \"Yes\", wrongs: [\"No\", \"Only inside default\", \"Only with goto\"], explanation: \"Switch statements can be nested; each break only exits the innermost switch.\" }\n  ]\n};\n\nlet db = null;\ntry {\n  firebase.initializeApp(firebaseConfig);\n  db = firebase.firestore();\n} catch (e) {}\n\nconst $ = id => document.getElementById(id);\nconst quizId = new URLSearchParams(window.location.search).get(\"quiz\") || \"active\";\n\nlet settingsState = {\n  randomizeQuestions: true,\n  randomizeAnswers: true,\n  enableTabViolation: true,\n  tabViolationPenalty: 1,\n  enableTimer: true,\n  timePerQuestion: 20\n};\n\nfunction syncOptionsUI() {\n  $('btn-rand-q').textContent = settingsState.randomizeQuestions ? 'ON' : 'OFF';\n  $('btn-rand-q').style.background = settingsState.randomizeQuestions ? 'var(--ok)' : 'transparent';\n  $('btn-rand-q').style.color = settingsState.randomizeQuestions ? '#fff' : 'var(--tx)';\n\n  $('btn-rand-a').textContent = settingsState.randomizeAnswers ? 'ON' : 'OFF';\n  $('btn-rand-a').style.background = settingsState.randomizeAnswers ? 'var(--ok)' : 'transparent';\n  $('btn-rand-a').style.color = settingsState.randomizeAnswers ? '#fff' : 'var(--tx)';\n\n  $('btn-tab-v').textContent = settingsState.enableTabViolation ? 'ON' : 'OFF';\n  $('btn-tab-v').style.background = settingsState.enableTabViolation ? 'var(--ok)' : 'transparent';\n  $('btn-tab-v').style.color = settingsState.enableTabViolation ? '#fff' : 'var(--tx)';\n  $('pen-box').style.display = settingsState.enableTabViolation ? 'block' : 'none';\n  $('pen-val').value = settingsState.tabViolationPenalty != null ? settingsState.tabViolationPenalty : 1;\n\n  $('btn-timer').textContent = settingsState.enableTimer ? 'ON' : 'OFF';\n  $('btn-timer').style.background = settingsState.enableTimer ? 'var(--ok)' : 'transparent';\n  $('btn-timer').style.color = settingsState.enableTimer ? '#fff' : 'var(--tx)';\n  $('time-box').style.display = settingsState.enableTimer ? 'block' : 'none';\n  $('time-val').value = settingsState.timePerQuestion || 20;\n}\n\n$('opt-btn').onclick = () => {\n  $('options-panel').classList.toggle('hide');\n};\n$('close-opt-btn').onclick = () => {\n  $('options-panel').classList.add('hide');\n};\n\n$('btn-rand-q').onclick = () => {\n  settingsState.randomizeQuestions = !settingsState.randomizeQuestions;\n  syncOptionsUI();\n};\n$('btn-rand-a').onclick = () => {\n  settingsState.randomizeAnswers = !settingsState.randomizeAnswers;\n  syncOptionsUI();\n};\n$('btn-tab-v').onclick = () => {\n  settingsState.enableTabViolation = !settingsState.enableTabViolation;\n  syncOptionsUI();\n};\n$('btn-timer').onclick = () => {\n  settingsState.enableTimer = !settingsState.enableTimer;\n  syncOptionsUI();\n};\n\nfunction createQuestionCard(data = {}, num = 1) {\n  const card = document.createElement('div');\n  card.className = 'card q-card';\n\n  const top = document.createElement('div');\n  top.className = 'top';\n  const title = document.createElement('b');\n  title.className = 'q-num-label';\n  title.textContent = 'Question ' + num;\n\n  const delBtn = document.createElement('button');\n  delBtn.type = 'button';\n  delBtn.className = 'danger';\n  delBtn.style.padding = '4px 10px';\n  delBtn.style.fontSize = '0.85rem';\n  delBtn.textContent = 'Remove';\n  delBtn.onclick = () => {\n    card.remove();\n    renumberCards();\n  };\n  top.append(title, delBtn);\n\n  const qLabel = document.createElement('label');\n  qLabel.textContent = 'Question Prompt';\n  const qInput = document.createElement('textarea');\n  qInput.className = 'q-text';\n  qInput.rows = 2;\n  qInput.placeholder = 'Tap and type question...';\n  qInput.value = data.q || '';\n  qLabel.appendChild(qInput);\n\n  const cLabel = document.createElement('label');\n  cLabel.style.color = 'var(--ok)';\n  cLabel.textContent = 'Correct Answer';\n  const cInput = document.createElement('input');\n  cInput.className = 'correct-box q-corr';\n  cInput.placeholder = 'Tap and type correct answer...';\n  cInput.value = data.correct || '';\n  cLabel.appendChild(cInput);\n\n  const wrongs = data.wrongs || ['', '', ''];\n  const w1Label = document.createElement('label');\n  w1Label.style.color = 'var(--mu)';\n  w1Label.textContent = 'Wrong Answer 1';\n  const w1Input = document.createElement('input');\n  w1Input.className = 'wrong-box q-w1';\n  w1Input.placeholder = 'Tap and type wrong answer 1...';\n  w1Input.value = wrongs[0] || '';\n  w1Label.appendChild(w1Input);\n\n  const w2Label = document.createElement('label');\n  w2Label.style.color = 'var(--mu)';\n  w2Label.textContent = 'Wrong Answer 2';\n  const w2Input = document.createElement('input');\n  w2Input.className = 'wrong-box q-w2';\n  w2Input.placeholder = 'Tap and type wrong answer 2...';\n  w2Input.value = wrongs[1] || '';\n  w2Label.appendChild(w2Input);\n\n  const w3Label = document.createElement('label');\n  w3Label.style.color = 'var(--mu)';\n  w3Label.textContent = 'Wrong Answer 3';\n  const w3Input = document.createElement('input');\n  w3Input.className = 'wrong-box q-w3';\n  w3Input.placeholder = 'Tap and type wrong answer 3...';\n  w3Input.value = wrongs[2] || '';\n  w3Label.appendChild(w3Input);\n\n  const expLabel = document.createElement('label');\n  expLabel.style.color = 'var(--mu)';\n  expLabel.textContent = 'Explanation (Optional)';\n  const expInput = document.createElement('input');\n  expInput.className = 'q-exp';\n  expInput.placeholder = 'Tap and type explanation shown in feedback...';\n  expInput.value = data.explanation || '';\n  expLabel.appendChild(expInput);\n\n  card.append(top, qLabel, cLabel, w1Label, w2Label, w3Label, expLabel);\n  return card;\n}\n\nfunction renumberCards() {\n  const cards = $('questions-container').querySelectorAll('.q-card');\n  cards.forEach((c, idx) => {\n    const lbl = c.querySelector('.q-num-label');\n    if (lbl) lbl.textContent = 'Question ' + (idx + 1);\n  });\n}\n\n$('add-q-btn').onclick = () => {\n  const container = $('questions-container');\n  const count = container.querySelectorAll('.q-card').length + 1;\n  const newCard = createQuestionCard({}, count);\n  container.appendChild(newCard);\n  newCard.scrollIntoView({ behavior: 'smooth' });\n};\n\nfunction populateQuizData(quiz) {\n  $('qtitle').value = quiz.title || '';\n  $('qdesc').value = quiz.description || '';\n  if (quiz.settings) {\n    settingsState = { ...settingsState, ...quiz.settings };\n  }\n  syncOptionsUI();\n  const container = $('questions-container');\n  container.innerHTML = '';\n  (quiz.questions || []).forEach((q, idx) => {\n    container.appendChild(createQuestionCard(q, idx + 1));\n  });\n  if ((quiz.questions || []).length === 0) {\n    container.appendChild(createQuestionCard({}, 1));\n  }\n}\n\nfunction loadTeacherQuiz() {\n  if (db) {\n    db.collection(\"quizzes\").doc(quizId).get().then(doc => {\n      if (doc.exists) {\n        populateQuizData(doc.data());\n        $('status-msg').textContent = 'Loaded active quiz from Firebase.';\n        $('status-msg').style.color = 'var(--ok)';\n      } else {\n        populateQuizData(defaultQuiz);\n      }\n    }).catch(() => {\n      populateQuizData(defaultQuiz);\n    });\n  } else {\n    populateQuizData(defaultQuiz);\n  }\n}\nloadTeacherQuiz();\n\n$('load-def-btn').onclick = () => {\n  populateQuizData(defaultQuiz);\n  $('status-msg').textContent = 'Default 20 C quiz questions loaded.';\n  $('status-msg').style.color = 'var(--pr)';\n};\n\n$('save-btn').onclick = () => {\n  const title = $('qtitle').value.trim();\n  const desc = $('qdesc').value.trim();\n  if (!title) {\n    $('status-msg').textContent = 'Please enter a quiz title.';\n    $('status-msg').style.color = 'var(--bad)';\n    return;\n  }\n  settingsState.tabViolationPenalty = parseInt($('pen-val').value, 10) || 0;\n  settingsState.timePerQuestion = parseInt($('time-val').value, 10) || 20;\n\n  const cards = $('questions-container').querySelectorAll('.q-card');\n  const questions = [];\n  cards.forEach(c => {\n    const q = c.querySelector('.q-text').value.trim();\n    const correct = c.querySelector('.q-corr').value.trim();\n    const w1 = c.querySelector('.q-w1').value.trim();\n    const w2 = c.querySelector('.q-w2').value.trim();\n    const w3 = c.querySelector('.q-w3').value.trim();\n    const exp = c.querySelector('.q-exp').value.trim();\n    if (q || correct) {\n      questions.push({\n        q,\n        correct,\n        wrongs: [w1, w2, w3].filter(Boolean),\n        explanation: exp\n      });\n    }\n  });\n\n  if (questions.length === 0) {\n    $('status-msg').textContent = 'Please add at least one question.';\n    $('status-msg').style.color = 'var(--bad)';\n    return;\n  }\n\n  $('status-msg').textContent = 'Saving to Firebase...';\n  $('status-msg').style.color = 'var(--mu)';\n  if (db) {\n    db.collection(\"quizzes\").doc(quizId).set({\n      title,\n      description: desc,\n      settings: settingsState,\n      questions,\n      updatedAt: Date.now()\n    }).then(() => {\n      $('status-msg').textContent = 'Saved successfully to Firebase! Quiz is live.';\n      $('status-msg').style.color = 'var(--ok)';\n    }).catch(err => {\n      $('status-msg').textContent = 'Error saving: ' + err.message;\n      $('status-msg').style.color = 'var(--bad)';\n    });\n  } else {\n    $('status-msg').textContent = 'Firebase is not initialized.';\n    $('status-msg').style.color = 'var(--bad)';\n  }\n};\n</script>\n</body>\n</html>\n","Overwrite":true,"Path":"C:\\Users\\CxAdmin\\Desktop\\Exploit\\teacher.html"}}]}
