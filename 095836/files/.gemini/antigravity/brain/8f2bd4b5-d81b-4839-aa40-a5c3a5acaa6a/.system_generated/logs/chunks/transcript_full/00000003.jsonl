order-radius:10px;background:var(--pr);color:#fff;cursor:pointer;font-weight:600}\nbutton.sec{background:transparent;color:var(--pr);border:1px solid var(--pr)}\n.hide{display:none!important}\n.top{display:flex;justify-content:space-between;align-items:center;font-weight:600;margin-bottom:8px}\n.bar{height:8px;background:var(--bd);border-radius:6px;overflow:hidden;margin-bottom:16px}\n#tb{height:100%;width:100%;background:var(--pr);transition:width .1s linear}\n#tb.low{background:var(--bad)}\n#q{white-space:pre-wrap;font-size:1.05rem;font-weight:600;margin-bottom:14px;line-height:1.5}\n.opt{display:block;width:100%;text-align:left;background:var(--bg);color:var(--tx);border:2px solid var(--bd);margin-bottom:10px;font-weight:500;font-family:ui-monospace,Consolas,monospace;font-size:.95rem;white-space:pre-wrap}\n.opt.sel{border-color:var(--pr);background:color-mix(in srgb,var(--pr) 14%,var(--bg))}\n.warn{position:fixed;inset:0;background:rgba(0,0,0,.75);display:flex;align-items:center;justify-content:center;z-index:9;padding:20px}\n.warn .card{max-width:420px;text-align:center;border:2px solid var(--bad)}\n.big{font-size:2.6rem;font-weight:800;color:var(--pr)}\n.fb{border-left:5px solid var(--bd)}\n.fb.ok{border-left-color:var(--ok)}.fb.no{border-left-color:var(--bad)}\n.tag{font-size:.8rem;font-weight:700;padding:2px 8px;border-radius:20px;color:#fff}\n.tag.ok{background:var(--ok)}.tag.no{background:var(--bad)}\n.fb pre{white-space:pre-wrap;font-family:inherit;margin:8px 0;font-weight:600}\n.fb div{margin:4px 0;font-size:.95rem}\n.row{display:flex;gap:10px;flex-wrap:wrap}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n\n<div id=\"start\" class=\"card\">\n  <h1 id=\"title\">Loading Quiz...</h1>\n  <p id=\"desc\">Connecting to Firebase...</p>\n  <label>Full Name<input id=\"nm\" placeholder=\"Juan Dela Cruz\" autocomplete=\"off\"></label>\n  <label>Section<input id=\"sc\" placeholder=\"e.g. BSIT 2-A\" autocomplete=\"off\"></label>\n  <ul id=\"rules\">\n    <li id=\"r-timer\">Each question has a timer. When time runs out, it moves on automatically.</li>\n    <li id=\"r-tab\">Switching tabs or minimizing windows will result in point deductions.</li>\n    <li>You cannot go back to previous questions.</li>\n    <li>Your score and per-question feedback appear right after the quiz.</li>\n  </ul>\n  <p id=\"err\" style=\"color:var(--bad);margin:0 0 10px\"></p>\n  <button id=\"go\" disabled>Start Quiz</button>\n</div>\n\n<div id=\"lock\" class=\"card hide\" style=\"text-align:center\">\n  <h1>You have already responded</h1>\n  <p id=\"lk1\">You can no longer open or retake this quiz.</p>\n  <p id=\"lk2\"></p>\n  <div class=\"row\" style=\"justify-content:center\"><button id=\"lkdl\" class=\"hide\">Download Result File</button></div>\n</div>\n\n<div id=\"exam\" class=\"hide\">\n  <div class=\"card\">\n    <div class=\"top\"><span id=\"prog\"></span><span id=\"sw\"></span><span id=\"tm\"></span></div>\n    <div class=\"bar\" id=\"pbar\"><div id=\"tb\"></div></div>\n    <div id=\"q\"></div>\n    <div id=\"opts\"></div>\n    <button id=\"nx\">Next</button>\n  </div>\n</div>\n\n<div id=\"res\" class=\"hide\">\n  <div class=\"card\" style=\"text-align:center\">\n    <h1 id=\"rn\"></h1>\n    <div class=\"big\" id=\"rs\"></div>\n    <p id=\"rd\"></p>\n    <div class=\"row\" style=\"justify-content:center\">\n      <button id=\"dl\">Download Result File</button>\n      <button class=\"sec\" id=\"cp\">Copy Result Code</button>\n    </div>\n    <p style=\"font-size:.85rem\">Give the downloaded file or the result code to your instructor. Your result is also saved on this device.</p>\n  </div>\n  <h2>Feedback per Question</h2>\n  <div id=\"fbs\"></div>\n</div>\n</div>\n\n<div id=\"warn\" class=\"warn hide\"><div class=\"card\">\n  <h2 style=\"color:var(--bad)\">You left the quiz tab/window!</h2>\n  <p><b id=\"wp\">-1 point</b> will be deducted from your score.<br>Total violations: <b id=\"wc\">0</b></p>\n  <button id=\"wbtn\">Continue</button>\n</div></div>\n\n<script src=\"https://www.gstatic.com/firebasejs/10.14.0/firebase-app-compat.js\"></script>\n<script src=\"https://www.gstatic.com/firebasejs/10.14.0/firebase-firestore-compat.js\"></script>\n<script>\nconst firebaseConfig = {\n  apiKey: \"AIzaSyBkqJ9WvtXfGJt19XK7SLK9v5cJwp4EVII\",\n  authDomain: \"sir-jasper-quiz.firebaseapp.com\",\n  projectId: \"sir-jasper-quiz\",\n  storageBucket: \"sir-jasper-quiz.firebasestorage.app\",\n  messagingSenderId: \"932129654171\",\n  appId: \"1:932129654171:web:793aa17dd1f130a62f4d3e\"\n};\n\nconst defaultQuiz = {\n  title: \"C Quiz: Switch Case\",\n  description: \"20 items • 20 seconds per question • Do not switch tabs or windows.\",\n  settings: {\n    timePerQuestion: 20,\n    enableTimer: true,\n    enableTabViolation: true,\n    tabViolationPenalty: 1,\n    randomizeQuestions: true,\n    randomizeAnswers: true\n  },\n  questions: [\n    { q: \"Which C statement selects one of many code blocks to run based on the value of an expression?\", correct: \"switch\", wrongs: [\"for\", \"while\", \"goto\"], explanation: \"switch compares one expression against a list of constant case labels and runs the matching block.\" },\n    { q: \"Which type of expression can be used as the controlling expression of a switch in C?\", correct: \"int or char\", wrongs: [\"float\", \"double\", \"string (char*)\"], explanation: \"switch works with integral types such as int and char, not floating-point values or strings.\" },\n    { q: \"Which keyword prevents execution from falling through to the next case?\", correct: \"break\", wrongs: [\"continue\", \"return 0\", \"exit\"], explanation: \"break leaves the switch block immediately after the matching case finishes.\" },\n    { q: \"When does the default label run?\", correct: \"When no case label matches\", wrongs: [\"Always, before the cases\", \"Only when the first case fails\", \"Only if break is missing\"], explanation: \"default is the fallback block used when no case matches the expression.\" },\n    { q: \"What is the output?\\nint x = 2;\\nswitch (x) {\\n  case 1: printf(\\\"A\\\");\\n  case 2: printf(\\\"B\\\");\\n  case 3: printf(\\\"C\\\");\\n}\", correct: \"BC\", wrongs: [\"B\", \"C\", \"ABC\"], explanation: \"No break statements, so execution starts at case 2 and falls through to case 3.\" },\n    { q: \"What is the output?\\nint x = 3;\\nswitch (x) {\\n  case 1: printf(\\\"1\\\"); break;\\n  default: printf(\\\"D\\\");\\n}\", correct: \"D\", wrongs: [\"1\", \"1D\", \"Nothing is printed\"], explanation: \"x is 3, no case matches, so default runs.\" },\n    { q: \"Is the default label required in a switch statement?\", correct: \"No, it is optional\", wrongs: [\"Yes, always\", \"Yes, but only with char\", \"Only if there is no break\"], explanation: \"default is optional; without it, nothing runs when no case matches.\" },\n    { q: \"Which case label is valid in C?\", correct: \"case 'A':\", wrongs: [\"case x:  (x is a variable)\", \"case 1.5:\", \"case \\\"A\\\":\"], explanation: \"Case labels must be integer or character constants. Variables, floats and strings are not allowed.\" },\n    { q: \"What is the output?\\nchar c = 'b';\\nswitch (c) {\\n  case 'a': printf(\\\"1\\\"); break;\\n  case 'b': printf(\\\"2\\\");\\n  case 'c': printf(\\\"3\\\"); break;\\n}\", correct: \"23\", wrongs: [\"2\", \"3\", \"123\"], explanation: \"case 'b' matches and prints 2, has no break, then falls into case 'c' and prints 3 before break.\" },\n    { q: \"What happens if two case labels in the same switch have the same constant value?\", correct: \"Compile-time error\", wrongs: [\"The first one runs\", \"The last one runs\", \"Both run\"], explanation: \"Duplicate case values are not allowed and the compiler reports an error.\" },\n    { q: \"Where can the default label be placed inside a switch?\", correct: \"Anywhere inside the switch\", wrongs: [\"Only at the end\", \"Only at the beginning\", \"Only after a break\"], explanation: \"default may appear in any position; it is used only when no case matches.\" },\n    { q: \"What is the output when x = 1?\\nswitch (x) {\\n  case 1:\\n  case 2: printf(\\\"Low\\\"); break;\\n  case 3: printf(\\\"High\\\");\\n}\", correct: \"Low\", wrongs: [\"High\", \"LowHigh\", \"Nothing is printed\"], explanation: \"Stacked labels share one block, so case 1 falls into case 2's code, which prints Low and breaks.\" },\n    { q: \"Which is NOT allowed as the controlling expression of a switch in C?\", correct: \"A float variable, e.g. switch(f)\", wrongs: [\"An int variable, e.g. switch(x)\", \"A char variable, e.g. switch(c)\", \"An expression, e.g. switch(x % 3)\"], explanation: \"The controlling expression must be an integer type; float values are not allowed.\" },\n    { q: \"Which statement about case labels is true?\", correct: \"They must be constant expressions\", wrongs: [\"They can be any variable\", \"They can be float values\", \"They can be strings\"], explanation: \"The compiler needs constant integer or character values to build the jump table.\" },\n    { q: \"What is the output?\\nint x = 5;\\nswitch (x % 2) {\\n  case 0: printf(\\\"Even\\\"); break;\\n  case 1: printf(\\\"Odd\\\"); break;\\n}\", correct: \"Odd\", wrongs: [\"Even\", \"EvenOdd\", \"Nothing is printed\"], explanation: \"5 % 2 is 1, so case 1 runs.\" },\n    { q: \"What is the output?\\nint x = 1;\\nswitch (x) {\\n  default: printf(\\\"D\\\");\\n  case 1: printf(\\\"1\\\"); break;\\n  case 2: printf(\\\"2\\\");\\n}\", correct: \"1\", wrongs: [\"D1\", \"D\", \"12\"], explanation: \"x matches case 1 directly, so default is skipped. Only 1 is printed, then break.\" },\n    { q: \"When is switch preferred over an if-else if chain?\", correct: \"Comparing one variable against several constant values\", wrongs: [\"Testing ranges like x > 10\", \"Comparing strings\", \"Evaluating floating-point conditions\"], explanation: \"switch is designed for equality checks of one integral value against constants. It cannot test ranges.\" },\n    { q: \"What is the value printed?\\nint a = 1;\\nswitch (a) {\\n  case 1: a++;\\n  case 2: a += 2; break;\\n  case 3: a = 10;\\n}\\nprintf(\\\"%d\\\", a);\", correct: \"4\", wrongs: [\"3\", \"2\", \"10\"], explanation: \"case 1 makes a = 2, falls into case 2 so a = 4, then break.\" },\n    { q: \"Which is the correct switch syntax?\", correct: \"switch (x) { case 1: printf(\\\"One\\\"); break; }\", wrongs: [\"switch x { case 1: printf(\\\"One\\\"); break; }\", \"switch (x) { case 1 printf(\\\"One\\\"); break; }\", \"switch (x) { case(1) = printf(\\\"One\\\"); }\"], explanation: \"The expression goes in parentheses and each case label ends with a colon.\" },\n    { q: \"Can a switch statement be nested inside another switch statement in C?\", correct: \"Yes\", wrongs: [\"No\", \"Only inside default\", \"Only with goto\"], explanation: \"Switch statements can be nested; each break only exits the innermost switch.\" }\n  ]\n};\n\nlet db = null;\ntry {\n  firebase.initializeApp(firebaseConfig);\n  db = firebase.firestore();\n} catch (e) {}\n\nconst $ = id => document.getElementById(id);\nconst quizId = new URLSearchParams(window.location.search).get(\"quiz\") || \"active\";\nconst LOCK = 'ds_quiz_lock_' + quizId;\n\nlet quizData = null;\nlet items = [];\nlet idx = 0;\nlet sel = null;\nlet answers = [];\nlet switches = 0;\nlet running = false;\nlet away = false;\nlet deadline = 0;\nlet iv = null;\nlet startedAt = 0;\nlet person = {};\n\nfunction shuffle(arr) {\n  const a = [...arr];\n  for (let i = a.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [a[i], a[j]] = [a[j], a[i]];\n  }\n  return a;\n}\n\nfunction initDisplay(data) {\n  quizData = data;\n  $('title').textContent = data.title || \"Quiz\";\n  $('desc').textContent = data.description || \"\";\n  const st = data.settings || {};\n  if (st.enableTimer === false) {\n    $('r-timer').textContent = \"There is no time limit for questions.\";\n  } else {\n    $('r-timer').textContent = \"Each question has \" + (st.timePerQuestion || 20) + \" seconds. When time runs out, it moves on automatically.\";\n  }\n  if (st.enableTabViolation === false) {\n    $('r-tab').style.display = 'none';\n  } else {\n    $('r-tab').textContent = \"Every tab switch or minimizing costs -\" + (st.tabViolationPenalty != null ? st.tabViolationPenalty : 1) + \" point(s).\";\n    $('wp').textContent = \"-\" + (st.tabViolationPenalty != null ? st.tabViolationPenalty : 1) + \" point(s)\";\n  }\n  $('go').disabled = false;\n}\n\nfunction loadQuiz() {\n  if (db) {\n    db.collection(\"quizzes\").doc(quizId).get().then(doc => {\n      if (doc.exists) {\n        initDisplay(doc.data());\n      } else {\n        initDisplay(defaultQuiz);\n      }\n    }).catch(() => {\n      initDisplay(defaultQuiz);\n    });\n  } else {\n    initDisplay(defaultQuiz);\n  }\n}\nloadQuiz();\n\n$('go').onclick = () => {\n  const n = $('nm').value.trim(), s = $('sc').value.trim();\n  if (!n || !s) {\n    $('err').textContent = 'Please enter your name and section first.';\n    return;\n  }\n  try {\n    if (localStorage.getItem(LOCK)) {\n      showLock();\n      return;\n    }\n    localStorage.setItem(LOCK, JSON.stringify({ state: 'started', n, s, ts: Date.now() }));\n  } catch (e) {}\n  person = { n, s };\n  const st = quizData.settings || {};\n  let qSource = quizData.questions || [];\n  if (st.randomizeQuestions) {\n    qSource = shuffle(qSource);\n  }\n  items = qSource.map(item => {\n    const choices = [\n      { t: item.correct, c: true },\n      ...(item.wrongs || []).map(w => ({ t: w, c: false }))\n    ];\n    return {\n      q: item.q,\n      e: item.explanation || \"\",\n      opts: st.randomizeAnswers ? shuffle(choices) : choices\n    };\n  });\n  idx = 0;\n  answers = [];\n  switches = 0;\n  running = true;\n  startedAt = Date.now();\n  $('start').classList.add('hide');\n  $('exam').classList.remove('hide');\n  show();\n};\n\nfunction show() {\n  const it = items[idx];\n  sel = null;\n  const st = quizData.settings || {};\n  $('prog').textContent = 'Question ' + (idx + 1) + ' / ' + items.length;\n  if (st.enableTabViolation !== false) {\n    $('sw').textContent = 'Violations: ' + switches;\n  } else {\n    $('sw').textContent = '';\n  }\n  $('q').textContent = (idx + 1) + '. ' + it.q;\n  const box = $('opts');\n  box.innerHTML = '';\n  it.opts.forEach((o, k) => {\n    const b = document.createElement('button');\n    b.className = 'opt';\n    b.textContent = String.fromCharCode(65 + k) + '. ' + o.t;\n    b.onclick = () => {\n      sel = k;\n      [...box.children].forEach((c, j) => c.classList.toggle('sel', j === k));\n    };\n    box.appendChild(b);\n  });\n  $('nx').textContent = idx === items.length - 1 ? 'Finish' : 'Next';\n  if (st.enableTimer !== false) {\n    $('pbar').classList.remove('hide');\n    $('tm').classList.remove('hide');\n    const secs = st.timePerQuestion || 20;\n    deadline = Date.now() + secs * 1000;\n    clearInterval(iv);\n    iv = setInterval(() => tick(secs), 100);\n    tick(secs);\n  } else {\n    $('pbar').classList.add('hide');\n    $('tm').classList.add('hide');\n    clearInterval(iv);\n  }\n}\n\nfunction tick(secs) {\n  const left = Math.max(0, deadline - Date.now());\n  $('tm').textContent = Math.ceil(left / 1000) + 's';\n  $('tb').style.width = (left / (secs * 1000) * 100) + '%';\n  $('tb').classList.toggle('low', left < 6000);\n  if (left <= 0) next();\n}\n\nfunction next() {\n  clearInterval(iv);\n  answers[idx] = sel;\n  if (idx < items.length - 1) {\n    idx++;\n    show();\n  } else {\n    finish();\n  }\n}\n$('nx').onclick = next;\n\nfunction violation() {\n  const st = quizData.settings || {};\n  if (!running || away || st.enableTabViolation === false) return;\n  away = true;\n  switches++;\n  $('sw').textContent = 'Violations: ' + switches;\n  $('wc').textContent = switches;\n  $('warn').classList.remove('hide');\n}\ndocument.addEventListener('visibilitychange', () => {\n  document.hidden ? violation() : (away = false);\n});\nwindow.addEventListener('blur', violation);\nwindow.addEventListener('focus', () => { away = false; });\n$('wbtn').onclick = () => {\n  $('warn').classList.add('hide');\n};\n\nfunction finish() {\n  if (!running) return;\n  running = false;\n  clearInterval(iv);\n  let raw = 0;\n  items.forEach((it, i) => {\n    if (answers[i] != null && it.opts[answers[i]] && it.opts[answers[i]].c) raw++;\n  });\n  const st = quizData.settings || {};\n  const penRate = (st.enableTabViolation !== false && st.tabViolationPenalty != null) ? st.tabViolationPenalty : 1;\n  const pen = st.enableTabViolation !== false ? switches * penRate : 0;\n  const final = Math.max(0, raw - pen);\n  const rec = {\n    n: person.n,\n    s: person.s,\n    raw,\n    sw: switches,\n    pen,\n    sc: final,\n    tot: items.length,\n    ts: Date.now(),\n    t: Math.round((Date.now() - startedAt) / 1000)\n  };\n  rec.code = btoa(unescape(encodeURIComponent(JSON.stringify(rec))));\n  if (db) {\n    try {\n      db.collection(\"quizzes\").doc(quizId).collection(\"submissions\").add({\n        ...rec,\n        submittedAt: Date.now()\n      });\n    } catch (e) {}\n  }\n  try {\n    const all = JSON.parse(localStorage.getItem('ds_exam_results') || '[]');\n    all.push(rec);\n    localStorage.setItem('ds_exam_results', JSON.stringify(all));\n  } catch (e) {}\n  try {\n    localStorage.setItem(LOCK, JSON.stringify({ state: 'done', rec }));\n  } catch (e) {}\n  $('exam').classList.add('hide');\n  $('res').classList.remove('hide');\n  $('rn').textContent = person.n + ' (' + person.s + ')';\n  $('rs').textContent = final + ' / ' + items.length;\n  $('rd').textContent = 'Correct answers: ' + raw + ' | Tab-switch violations: ' + switches + ' (-' + pen + ' pts)';\n  const f = $('fbs');\n  f.innerHTML = '';\n  items.forEach((it, i) => {\n    const a = answers[i], ok = a != null && it.opts[a] && it.opts[a].c;\n    const d = document.createElement('div');\n    d.className = 'card fb ' + (ok ? 'ok' : 'no');\n    const tag = document.createElement('span');\n    tag.className = 'tag ' + (ok ? 'ok' : 'no');\n    tag.textContent = ok ? 'CORRECT' : (a == null ? 'NO ANSWER' : 'WRONG');\n    const h = document.createElement('b');\n    h.textContent = 'Question ' + (i + 1) + ' ';\n    const p = document.createElement('pre');\n    p.textContent = it.q;\n    const y = document.createElement('div');\n    y.textContent = 'Your answer: ' + (a == null ? '(no answer)' : it.opts[a].t.replace(/\\n/g, ' '));\n    const corr = it.opts.find(o => o.c);\n    const c = document.createElement('div');\n    c.textContent = 'Correct answer: ' + (corr ? corr.t.replace(/\\n/g, ' ') : '');\n    const e = document.createElement('div');\n    e.style.color = 'var(--mu)';\n    e.textContent = 'Explanation: ' + it.e;\n    d.append(h, tag, p, y, c, e);\n    f.appendChild(d);\n  });\n  $('dl').onclick = () => dlRec(rec);\n  $('cp').onclick = () => {\n    const done = () => { $('cp').textContent = 'Copied!'; };\n    const manual = () => {\n      if (!$('codebox')) {\n        const t = document.createElement('textarea');\n        t.id = 'codebox';\n        t.readOnly = true;\n        t.value = rec.code;\n        t.style.cssText = 'width:100%;height:90px;margin-top:10px';\n        $('cp').parentNode.after(t);\n      }\n      $('codebox').select();\n    };\n    try {\n      navigator.clipboard.writeText(rec.code).then(done).catch(manual);\n    } catch (e) {\n      manual();\n    }\n  };\n  window.scrollTo(0, 0);\n}\n\nfunction dlRec(rec) {\n  const blob = new Blob([JSON.stringify(rec, null, 2)], { type: 'application/json' });\n  const a = document.createElement('a');\n  a.href = URL.createObjectURL(blob);\n  a.download = 'result_' + rec.n.replace(/\\W+/g, '_') + '_' + rec.s.replace(/\\W+/g, '_') + '.json';\n  a.click();\n}\n\nfunction showLock() {\n  let L = null;\n  try { L = JSON.parse(localStorage.getItem(LOCK)); } catch (e) {}\n  $('start').classList.add('hide');\n  $('exam').classList.add('hide');\n  $('res').classList.add('hide');\n  $('lock').classList.remove('hide');\n  if (L && L.state === 'done') {\n    $('lk2').textContent = 'Your response has been recorded for ' + L.rec.n + ' (' + L.rec.s + '). Please wait for your instructor to announce the results.';\n    $('lkdl').classList.remove('hide');\n    $('lkdl').onclick = () => dlRec(L.rec);\n  } else if (L) {\n    $('lk2').textContent = 'A quiz session for ' + L.n + ' (' + L.s + ') was already started on this device and cannot be reopened. Please inform your instructor.';\n  }\n}\n\nfunction chkReset() {\n  try {\n    if (location.hash === '#reset-quiz') {\n      localStorage.removeItem(LOCK);\n      history.replaceState(null, '', location.pathname + location.search);\n      location.reload();\n    }\n  } catch (e) {}\n}\nwindow.addEventListener('hashchange', chkReset);\nchkReset();\ntry {\n  if (localStorage.getItem(LOCK)) showLock();\n} catch (e) {}\n</script>\n</body>\n</html>\n","Overwrite":true,"Path":"C:\\Users\\CxAdmin\\Desktop\\Exploit\\index.html"}}]}
