forEach((q, idx) => {\r\n    container.appendChild(createQuestionCard(q, idx + 1));\r\n  });\r\n  if ((quiz.questions || []).length === 0) {\r\n    container.appendChild(createQuestionCard({}, 1));\r\n  }\r\n}\r\n\r\nfunction loadTeacherQuiz() {\r\n  populateQuizData(defaultQuiz);\r\n  if (db) {\r\n    db.collection(\"quizzes\").doc(quizId).get().then(doc => {\r\n      if (doc.exists) {\r\n        populateQuizData(doc.data());\r\n        $('status-msg').textContent = 'Loaded active quiz from Firebase.';\r\n        $('status-msg').style.color = 'var(--ok)';\r\n      }\r\n    }).catch(() => {});\r\n  }\r\n}\r\nloadTeacherQuiz();\r\n\r\n$('load-def-btn').onclick = () => {\r\n  populateQuizData(defaultQuiz);\r\n  $('status-msg').textContent = 'Default 20 C quiz questions loaded.';\r\n  $('status-msg').style.color = 'var(--pr)';\r\n};\r\n\r\n$('save-btn').onclick = () => {\r\n  const title = $('qtitle').value.trim();\r\n  const desc = $('qdesc').value.trim();\r\n  if (!title) {\r\n    $('status-msg').textContent = 'Please enter a quiz title.';\r\n    $('status-msg').style.color = 'var(--bad)';\r\n    return;\r\n  }\r\n  settingsState.tabViolationPenalty = parseInt($('pen-val').value, 10) || 0;\r\n  settingsState.timePerQuestion = parseInt($('time-val').value, 10) || 20;\r\n\r\n  const cards = $('questions-container').querySelectorAll('.q-card');\r\n  const questions = [];\r\n  cards.forEach(c => {\r\n    const q = c.querySelector('.q-text').value.trim();\r\n    const correct = c.querySelector('.q-corr').value.trim();\r\n    const w1 = c.querySelector('.q-w1').value.trim();\r\n    const w2 = c.querySelector('.q-w2').value.trim();\r\n    const w3 = c.querySelector('.q-w3').value.trim();\r\n    const exp = c.querySelector('.q-exp').value.trim();\r\n    if (q || correct) {\r\n      questions.push({\r\n        q,\r\n        correct,\r\n        wrongs: [w1, w2, w3].filter(Boolean),\r\n        explanation: exp\r\n      });\r\n    }\r\n  });\r\n\r\n  if (questions.length === 0) {\r\n    $('status-msg').textContent = 'Please add at least one question.';\r\n    $('status-msg').style.color = 'var(--bad)';\r\n    return;\r\n  }\r\n\r\n  $('status-msg').textContent = 'Saving to Firebase...';\r\n  $('status-msg').style.color = 'var(--mu)';\r\n  if (db) {\r\n    db.collection(\"quizzes\").doc(quizId).set({\r\n      title,\r\n      description: desc,\r\n      settings: settingsState,\r\n      questions,\r\n      updatedAt: Date.now()\r\n    }).then(() => {\r\n      $('status-msg').textContent = 'Saved successfully to Firebase! Quiz is live.';\r\n      $('status-msg').style.color = 'var(--ok)';\r\n    }).catch(err => {\r\n      $('status-msg').textContent = 'Error saving: ' + err.message;\r\n      $('status-msg').style.color = 'var(--bad)';\r\n    });\r\n  } else {\r\n    $('status-msg').textContent = 'Firebase is not initialized.';\r\n    $('status-msg').style.color = 'var(--bad)';\r\n  }\r\n};\r\n</script>\r\n\r\n\r\n</body></html>\r\n"}
